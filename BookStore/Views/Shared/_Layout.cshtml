<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BookStore.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/logo.ico" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="header fixed-top bg-white">
        <div class="header-inner container-fluid">
            <div class="d-flex gap-2 align-items-center py-2 border-bottom">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" alt="BookStore Logo" class="logo" />
                </a>
                <div class="flex-fill ms-3">
                    <input type="search" class="search-product form-control rounded-5" placeholder="Search product" />
                </div>
                <div class="border-end px-3 text-nowrap">
                    Bonuses: 100
                </div>
                <div class="d-flex gap-2 ms-2">
                    <a class="btn btn-dark rounded-4 d-flex justify-content-center align-items-center header-btn" asp-area="Admin" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-shield"></i>
                    </a>
                    <button id="profileBtn" class="btn btn-light rounded-4 d-flex justify-content-center align-items-center header-btn">
                        <i class="bi bi-person"></i>
                    </button>
                    <a class="btn btn-light rounded-4 d-flex justify-content-center align-items-center header-btn" asp-area="" asp-controller="Wishlist" asp-action="Index">
                        <i class="bi bi-heart"></i>
                    </a>
                    <button id="cartBtn" class="btn btn-light rounded-4 d-flex justify-content-center align-items-center header-btn">
                        <i class="bi bi-cart"></i>
                    </button>
                </div>
            </div>
            <div class="d-flex gap-4 py-2">
                <a class="nav-link" asp-controller="Catalog" asp-action="Index">Catalog</a>
                <a class="nav-link" asp-controller="Catalog" asp-action="Index">E-books</a>
                <a class="nav-link" asp-controller="Catalog" asp-action="Index">Preorders</a>
                <a class="nav-link" asp-controller="Catalog" asp-action="Index">Merch</a>
                <a class="nav-link" asp-controller="Catalog" asp-action="Index">Sale</a>
                <a class="nav-link" asp-controller="Authors" asp-action="Index">Authors</a>
                <a class="nav-link" asp-controller="Home" asp-action="News">News</a>
            </div>
        </div>
    </header>
    <div class="container-fluid flex-fill main">
        <main role="main" class="mt-4">
            @RenderBody()
        </main>
    </div>

    <!-- Overlay -->
    <div id="overlay" class="overlay d-none position-fixed w-100 h-100"></div>

    <!-- Profile panel -->
    <div id="profile" class="profile d-none position-fixed h-100 bg-white">
        <div class="h-100 d-flex flex-column">
            <div class="d-flex justify-content-between align-items-center px-4 py-3 border-bottom">
                <span class="panel-header">Profile</span>
                <button id="profileCloseBtn" class="btn-close"></button>
            </div>
            <div class="px-4 py-3 overflow-y-auto">
                <div class="">
                    <div>
                        <span class="profile-header-2">Bonuses</span>
                    </div>
                    <div class="mt-3 rounded-4 border border-1 p-2">
                        <div class="d-flex gap-3 align-items-center">
                            <div class="profile-icon-big rounded-4 d-flex justify-content-center align-items-center">
                                <i class="bi bi-currency-bitcoin"></i>
                            </div>
                            <span class="profile-bonuses">100</span>
                        </div>
                    </div>
                    <div class="mt-3 d-flex justify-content-between align-items-center">
                        <span class="profile-header-2">Personal info</span>
                        <a class="profile-edit-button d-flex justify-content-center align-items-center btn btn-light rounded-5" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-pencil"></i>
                        </a>
                    </div>
                    <div class="mt-3 rounded-4 border border-1 p-2">
                        <div class="d-flex gap-3 align-items-center">
                            <div class="profile-icon-big rounded-4 d-flex justify-content-center align-items-center">
                                <i class="bi bi-person"></i>
                            </div>
                            <div class="d-flex flex-column gap-1">
                                <span class="profile-label text-muted">Name</span>
                                <span class="profile-value">Name</span>
                            </div>
                        </div>
                        <div class="d-flex gap-3 align-items-center border-top pt-2 mt-2">
                            <div class="profile-icon-big rounded-4 d-flex justify-content-center align-items-center">
                                <i class="bi bi-person"></i>
                            </div>
                            <div class="d-flex flex-column gap-1">
                                <span class="profile-label text-muted">Surname</span>
                                <span class="profile-value">Surname</span>
                            </div>
                        </div>
                        <div class="d-flex gap-3 align-items-center border-top pt-2 mt-2">
                            <div class="profile-icon rounded-4 d-flex justify-content-center align-items-center">
                                <i class="bi bi-calendar-event"></i>
                            </div>
                            <div class="d-flex flex-column gap-1">
                                <span class="profile-label text-muted">Date of birth</span>
                                <span class="profile-value">08.11.2000</span>
                            </div>
                        </div>
                        <div class="d-flex gap-3 align-items-center border-top pt-2 mt-2">
                            <div class="profile-icon rounded-4 d-flex justify-content-center align-items-center">
                                <i class="bi bi-envelope"></i>
                            </div>
                            <div class="d-flex flex-column gap-1">
                                <span class="profile-label text-muted">Email</span>
                                <span class="profile-value">emailaddress@gmail.com</span>
                            </div>
                        </div>
                        <div class="d-flex gap-3 align-items-center border-top pt-2 mt-2">
                            <div class="profile-icon rounded-4 d-flex justify-content-center align-items-center">
                                <i class="bi bi-telephone"></i>
                            </div>
                            <div class="d-flex flex-column gap-1">
                                <span class="profile-label text-muted">Phone numer</span>
                                <span class="profile-value">+380XXXXXXXXX</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="mt-3 d-flex flex-column">
                    <div class="rounded-4 border border-1 p-2">
                        <span>
                            Log in to add books to the wishlist, track order status, use the bonus program, and receive personalized discounts
                        </span>
                    </div>
                    <div class="mt-3">
                        <a class="profile-button btn btn-success rounded-4 d-flex justify-content-center align-items-center py-2 px-3" asp-controller="Account" asp-action="Login">
                            <span class="pe-3">Log in</span>
                            <i class="bi bi-box-arrow-in-right"></i>
                        </a>
                    </div>
                </div>
            </div>
            <div class="d-flex flex-column gap-3 mt-auto px-4 py-3">
                <a class="profile-button btn btn-secondary rounded-4 d-flex justify-content-center align-items-center py-2 px-3" asp-controller="Orders" asp-action="Index">
                    <span class="pe-3">My orders</span>
                    <i class="bi bi-bag"></i>
                </a>
                <a class="profile-button btn btn-secondary rounded-4 d-flex justify-content-center align-items-center py-2 px-3" asp-controller="Wishlist" asp-action="Index">
                    <span class="pe-3">Wishlist</span>
                    <i class="bi bi-heart"></i>
                </a>
                <a class="profile-button btn btn-danger rounded-4 d-flex justify-content-center align-items-center py-2 px-3" asp-controller="Home" asp-action="Index">
                    <span class="pe-3">Log out</span>
                    <i class="bi bi-box-arrow-left"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Cart panel -->
    <div id="cart" class="cart d-none position-fixed h-100 bg-white">
        <div class="h-100 d-flex flex-column">
            <div class="d-flex justify-content-between align-items-center px-4 py-3 border-bottom">
                <span class="panel-header">Cart</span>
                <button id="cartCloseBtn" class="btn-close"></button>
            </div>
            <div class="px-4 py-3 overflow-y-auto">
                @for (int i = 0; i < 3; i++)
                {
                    @await Html.PartialAsync("_CartItemElement")
                    ;
                }
            </div>
            <div class="position-sticky px-4 py-3 mt-auto border-top">
                <div class="d-flex justify-content-end align-items-end pb-3">
                    <span>Total:</span>
                    <span class="cart-total ps-2">1200 UAH</span>
                </div>
                <div class="d-flex gap-4">
                    <button class="profile-button w-100 btn btn-secondary rounded-4 d-flex justify-content-center align-items-center py-2 px-3">
                        <span class="pe-3">Clear cart</span>
                        <i class="bi bi-trash3"></i>
                    </button>
                    <a class="profile-button w-100 btn btn-success rounded-4 d-flex justify-content-center align-items-center py-2 px-3" asp-controller="Checkout" asp-action="Index">
                        <span class="pe-3">Submit order</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <footer class="mt-auto border-top text-muted py-3 bg-white">
        <div class="container-fluid footer-inner">
            &copy; 2025 - bookspace
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/profile.js" asp-append-version="true"></script>
    <script src="~/js/cart.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
