@model PhysicalBookEditViewModel

@{
    ViewData["Title"] = "Edit book";
}

<form asp-action="Edit" asp-route-id="@Model.Book.Id" method="post" enctype="multipart/form-data">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h2 class="mb-1">@Model.Book.Name</h2>
            <div class="d-flex gap-2 align-items-center">
                <span class="text-muted">ID: @Model.Book.Id</span>
            </div>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="admin-details-button btn btn-primary">
                <i class="bi bi-floppy"></i>
                <span>Save</span>
            </button>
            <button type="reset" class="admin-details-button btn btn-secondary">
                <i class="bi bi-arrow-clockwise"></i>
                <span>Reset</span>
            </button>
        </div>
    </div>

    <div class="mt-3">
        <div class="row">
            <div class="col-lg-5">
                <div class="bg-white rounded-4 p-3">
                    <div>
                        <input type="file" multiple name="Images" accept="image/*" class="form-control"/>
                        <div id="image-container" class="d-flex flex-wrap gap-3 p-2">
                            @for(int i = 0; i < Model.Book.OrderedImages.Count; i++)
                            {
                                var image = Model.Book.OrderedImages.ToList()[i];
                                <div class="image-item position-relative" draggable="true">
                                    <img class="admin-book-image-small" src="~/images/productImages/@image.Url" />
                                    <input hidden name="ImageOrders[@i].ImageId" type="number"
                                        value="@image.Id"/>
                                    <input hidden name="ImageOrders[@i].Order" type="number"
                                           value="@image.Number" />
                                </div>
                            }
                        </div>
                    </div>
                    <div class="mt-4">
                        <div>
                            <h5>Book Edition</h5>
                        </div>
                        <div class="list-group list-group-flush text-end">
                            <input hidden name="BookId" type="number" value="@Model.Book.Id" />
                            <div class="list-group-item d-flex justify-content-between gap-3">
                                <span class="text-nowrap">Edition</span>
                                <select name="BookEditionId" class="form-select w-50 py-0">
                                    @foreach (BookEdition edition in Model.BookEditions)
                                    {
                                        <option value="@edition.Id" selected="@(edition.Id == Model.Book.BookEditionId)">
                                            @edition.Title (@edition.Publisher?.Name)
                                        </option>
                                    }
                                </select>
                            </div>
                            @* <div class="list-group-item d-flex justify-content-between gap-3">
                                <span>Title</span>
                                <input name="Title" type="text" class="form-control py-0"
                                       value="@Model.Book.Title" />
                            </div>
                            <div class="list-group-item d-flex justify-content-between gap-3">
                                <span>Author</span>
                                <select name="AuthorId" class="form-select py-0">
                                    <option value="" selected="@(Model.Book.Authors.Count == 0)">-</option>
                                    @foreach (Author author in Model.Authors)
                                    {
                                        <option value="@author.Id" selected="@(author.Id == Model.Book.Authors.FirstOrDefault()?.Id)">
                                            @author.Name
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="list-group-item d-flex justify-content-between gap-3">
                                <span>Series</span>
                                <select id="seriesSelect" name="SeriesId" class="form-select py-0">
                                    <option value="" selected="@(Model.Book.SeriesId == null)">-</option>
                                    @foreach (Series series in Model.Series)
                                    {
                                        <option value="@series.Id" selected="@(series.Id == Model.Book.SeriesId)">
                                            @series.Name
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="list-group-item d-flex justify-content-between gap-3">
                                <span>Number is series</span>
                                <input id="numberInSeriesInput" name="NumberInSeries" type="number" min="0" class="form-control w-50 py-0"
                                       value="@Model.Book.NumberInSeries" />
                            </div>
                            <div class="list-group-item d-flex justify-content-between gap-3">
                                <span>Year</span>
                                <input name="Year" type="number" min="0" class="form-control w-50 py-0"
                                       value="@Model.Book.Year" />
                            </div>
                            <div class="list-group-item d-flex justify-content-between gap-3">
                                <span>Publisher</span>
                                <select name="PublisherId" class="form-select py-0">
                                    <option value="" selected="@(Model.Book.PublisherId == null)">-</option>
                                    @foreach (Publisher publisher in Model.Publishers)
                                    {
                                        <option value="@publisher.Id" selected="@(publisher.Id == Model.Book.PublisherId)">
                                            @publisher.Name
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="list-group-item d-flex justify-content-between gap-3">
                                <span>Translator</span>
                                <select name="TranslatorId" class="form-select py-0">
                                    <option value="" selected="@(Model.Book.Translators.Count == 0)">-</option>
                                    @foreach (Translator translator in Model.Translators)
                                    {
                                        <option value="@translator.Id" selected="@(translator.Id == Model.Book.Translators.FirstOrDefault()?.Id)">
                                            @translator.Name
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="list-group-item d-flex justify-content-between gap-3">
                                <span>Language</span>
                                <select name="LanguageId" class="form-select w-50 py-0">
                                    @foreach (Language language in Model.Languages)
                                    {
                                        <option value="@language.Id" selected="@(language.Id == Model.Book.LanguageId)">
                                            @language.Name
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="list-group-item d-flex justify-content-between gap-3">
                                <span>Has ebook</span>
                                <input @(Model.Book.DigitalBook != null ? "checked" : "") class="form-check-input" type="checkbox" name="HasDigitalBook" value="True" id="hasDigitalBook" />
                            </div> *@
                        </div>
                    </div>
                    <div class="mt-2">
                        <div>
                            <h5>Details</h5>
                        </div>
                        <div class="list-group list-group-flush text-end">
                            <div class="list-group-item d-flex justify-content-between gap-3">
                                <span class="text-nowrap">Slug</span>
                                <div class="d-flex text-muted">
                                    <span>Catalog/Physical/</span>
                                    <input name="Slug" type="text" class="form-control py-0"
                                           value="@Model.Book.Slug" />
                                </div>
                            </div>
                            <div class="list-group-item d-flex justify-content-between gap-3">
                                <span class="text-nowrap">Title Addition</span>
                                <input name="TitleAddition" type="text" class="form-control py-0"
                                       value="@Model.Book.TitleAddition" />
                            </div>
                            <div class="list-group-item d-flex justify-content-between gap-3">
                                <span class="text-nowrap">ISBN</span>
                                <input name="Isbn" type="text" class="form-control py-0"
                                       value="@Model.Book.Isbn" />
                            </div>
                            <div class="list-group-item d-flex justify-content-between gap-3">
                                <span class="text-nowrap">Cover type</span>
                                <select name="CoverType" class="form-select w-50 py-0">
                                    <option value="@CoverType.Hardcover">Hard cover</option>
                                    <option value="@CoverType.Paperback">Paperback</option>
                                </select>
                            </div>
                            <div class="list-group-item d-flex justify-content-between gap-3">
                                <span>Has illustrations</span>
                                <input @(Model.Book.HasIllustrations == true ? "checked" : "") class="form-check-input" type="checkbox" name="HasIllustrations" value="True" />
                            </div>
                            <div class="list-group-item d-flex justify-content-between gap-3">
                                <span class="text-nowrap">Pages</span>
                                <input name="Pages" type="number" min="0" class="form-control w-50 py-0"
                                       value="@Model.Book.Pages" />
                            </div>
                            <div class="list-group-item d-flex justify-content-between gap-3">
                                <span class="text-nowrap">Size</span>
                                <div class="d-flex">
                                    <span class="px-1">
                                        <i class="bi bi-arrows"></i>
                                    </span>
                                    <input name="Width" type="number" min="0" class="form-control w-50 py-0 px-2"
                                           value="@Model.Book.Width" />
                                    <span class="px-1">
                                        <i class="bi bi-arrows-vertical"></i>
                                    </span>
                                    <input name="Height" type="number" min="0" class="form-control w-50 py-0 px-2"
                                           value="@Model.Book.Height" />
                                    <span class="px-1">
                                        <i class="bi bi-arrows-angle-expand"></i>
                                    </span>
                                    <input name="Thickness" type="number" min="0" class="form-control w-50 py-0 px-2"
                                           value="@Model.Book.Thickness" />
                                </div>
                            </div>
                            <div class="list-group-item d-flex justify-content-between gap-3">
                                <span class="text-nowrap">Weight</span>
                                <input name="Weight" type="number" min="0" class="form-control w-50 py-0"
                                       value="@Model.Book.Weight" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-7 mt-4 mt-lg-0">
                <h5 class="">Stock and pricing</h5>
                <div class="row mt-2">
                    <div class="col-lg-6">
                        <div class="bg-white rounded-4 p-3">
                            <div class="d-flex gap-2">
                                <div class="w-100">
                                    <h6>Price</h6>
                                    <input id="priceInput" name="Price" type="number" min="0" class="form-control"
                                           value="@Model.Book.Price" />
                                </div>
                                <div class="w-100">
                                    <h6>Discount</h6>
                                    <select id="discountSelect" name="DiscountId" class="form-select">
                                        <option value="" selected="@(Model.Book.DiscountId == null)">-</option>
                                        @foreach (Discount discount in Model.Discounts)
                                        {
                                            <option value="@discount.Id" selected="@(discount.Id == Model.Book.DiscountId)"
                                                    data-type="@discount.GetType().Name"
                                                    data-value="@((discount as AmountDiscount)?.Amount ?? (discount as PercentageDiscount)?.Percentage)">
                                                @discount.Name (@discount.Display())
                                            </option>
                                        }
                                    </select>
                                </div>
                                <div class="w-100">
                                    <h6>Final price</h6>
                                    <input id="finalPriceInput" name="FinalPrice" type="number" min="0" class="form-control"
                                           value="@Model.Book.FinalPrice" />
                                </div>
                            </div>
                            <small class="text-muted">Discount valid: - </small>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="bg-white rounded-4 p-3 mt-3 mt-lg-0">
                            <h6>Stock</h6>
                            <div class="d-flex align-items-center">
                                <input name="Stock" type="number" min="0" class="form-control w-50"
                                       value="@Model.Book.Stock" />
                                <div class="ms-4">
                                    <input @(Model.Book.IsAvailable == true ? "checked" : "") class="form-check-input" type="checkbox" value="true" name="IsAvailable" id="isAvailable" />
                                    <label class="form-check-label ps-2" for="isAvailable">Available</label>
                                </div>
                            </div>
                            <small class="text-muted mt-4">Last restock:</small>
                        </div>
                    </div>
                </div>
                <div class="bg-white rounded-4 p-3 mt-4">
                    <h5>Visibility</h5>
                    <div class="mt-3 d-flex gap-3">
                        <div class="form-check">
                            <input @(Model.Book.IsVisible == true ? "checked" : "") class="form-check-input" type="radio" value="Visible" name="IsVisible" id="visibleRadio" />
                            <label class="form-check-label" for="visibleRadio">Visible</label>
                        </div>
                        <div class="form-check">
                            <input @(Model.Book.IsVisible == true ? "" : "checked") class="form-check-input" type="radio" value="Hidden" name="IsVisible" id="hiddenRadio" />
                            <label class="form-check-label" for="hiddenRadio">Hidden</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" value="Scheduled" name="IsVisible" id="scheduledAtRadio" />
                            <label class="form-check-label" for="scheduledAtRadio">Scheduled</label>
                        </div>
                    </div>
                    <div class="mt-2 w-50">
                        <input name="ScheduledAt" type="datetime-local" class="form-control" id="scheduledAt" disabled />
                    </div>
                </div>
                <div class="bg-white rounded-4 p-3 mt-4">
                    <h5>Tags</h5>
                    <div class="d-flex flex-wrap gap-2 mt-3">
                        @for (int i = 0; i < 6; i++)
                        {
                            <div class="bg-secondary-subtle d-flex align-items-center px-2 py-1 rounded-5">
                                <span class="me-1">Tag name</span>
                                <button type="button" class="admin-tag-button btn btn-outline-secondary d-flex justify-content-center align-items-center p-0 rounded-5">
                                    <i class="bi bi-x"></i>
                                </button>
                            </div>
                        }
                        <button type="button" class="btn btn-outline-primary d-flex justify-content-center align-items-center rounded-5">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                    </div>
                </div>
                <div class="bg-white rounded-4 p-3 mt-4">
                    <h5>Description Addition</h5>
                    <textarea name="DescriptionAddition" class="form-control mt-2" rows="20">@Model.Book.DescriptionAddition</textarea>
                </div>
            </div>
        </div>
    </div>
</form>

<script src="~/js/admin-book.js"></script>

<script>
    const container = document.getElementById("image-container");
    let draggedItem = null;

    container.addEventListener("dragstart", e => {
        draggedItem = e.target.closest(".image-item");
        draggedItem.classList.add("opacity-50");
    });

    container.addEventListener("dragend", () => {
        draggedItem.classList.remove("opacity-50");
        draggedItem = null;
        updateOrderNumbers();
    });

    container.addEventListener("dragover", e => {
        e.preventDefault();
        const target = e.target.closest(".image-item");
        if(!target || target === draggedItem) return;

        const rect = target.getBoundingClientRect();
        const next = (e.clientX - rect.left) > rect.width / 2;

        container.insertBefore(draggedItem, next ? target.nextSibling : target);
    });

    function updateOrderNumbers() {
        const items = container.querySelectorAll(".image-item");
        items.forEach((item, index) => {
            const input = item.querySelector('input[name$=".Order"]');
            input.value = index;
        });
    }
</script>