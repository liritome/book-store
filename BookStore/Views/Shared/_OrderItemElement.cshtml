<div class="py-2 d-flex justify-content-between align-items-center">
    <a class="orders-details-a d-flex align-items-center me-auto" asp-controller="Catalog" asp-action="Details" asp-route-slug="book-title">
        <img class="orders-image" src="~/images/book-empty.png" />
        <div class="d-flex flex-column gap-1 ps-3">
            <span class="orders-details-title">Book title super long version. Book 9. Delux edition</span>
            <span class="orders-details-author text-muted">Author Name</span>
        </div>
    </a>
    <div class="orders-details-price ps-2">
        <span>400 UAH</span>
    </div>
    <div class="orders-details-quantity ps-1">
        <span>x 1 =</span>
    </div>
    <div class="orders-details-total ps-1">
        <span>400 UAH</span>
    </div>
</div>