@{
    ViewData["Title"] = "Catalog";
}

<h2>Catalog of books</h2>
<div class="grid mt-4">
    @for (int i = 0; i < 11; i++)
    {
        <div class="catalog-card position-relative d-flex justify-content-between flex-column rounded-3 overflow-hidden">
            <div class="catalog-card-wish position-absolute">
                <button class="wish-button btn btn-light rounded-4 d-flex justify-content-center align-items-center">
                    <i class="bi bi-heart-fill"></i>
                </button>
            </div>
            <a class="p-3 text-decoration-none text-reset" asp-area="" asp-controller="Catalog" asp-action="Product">
                <div class="catalog-card-image mx-3">
                    <img src="~/images/book-empty.png" />
                </div>
                <div>
                    <span class="catalog-card-title mt-3">Book title super long version. Book 9. Delux edition</span>
                    <span class="catalog-card-author text-muted mt-2">Author Name, Second Author Name</span>
                </div>
                <div class="catalog-card-rating d-flex justify-content-between mt-3">
                    <div class="catalog-card-score position-relative">
                        <div class="star-bg">
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                        </div>
                        <div class="star-fg" style="width: 75%">
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                        </div>
                    </div>
                    <div class="catalog-card-reviews d-flex align-items-center gap-1">
                        <span>12</span>
                        <i class="bi bi-chat-left-fill"></i>
                    </div>
                </div>
                <div class="catalog-card-price d-flex flex-column mt-4">
                    <div class="catalog-card-main-price text-muted">500 UAH</div>
                    <div class="catalog-card-final-price">375 UAH</div>
                </div>
            </a>
            <div class="catalog-card-buy position-absolute">
                <button class="buy-button btn btn-secondary rounded-4 d-flex justify-content-center align-items-center">
                    <i class="bi bi-cart"></i>
                </button>
            </div>
        </div>
    }
</div>