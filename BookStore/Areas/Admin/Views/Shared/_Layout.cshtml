<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BookStore.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/logo.ico" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="header fixed-top bg-white">
        <div class="header-inner container-fluid">
            <div class="d-flex gap-2 align-items-center py-2 border-bottom">
                <a class="navbar-brand" asp-area="Admin" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" alt="BookStore Logo" class="logo" />
                </a>
                <div class="flex-fill ms-3">
                    <input type="search" class="search-product form-control rounded-5" placeholder="Search product by name or ID" />
                </div>
                <div class="d-flex gap-2 ms-2">
                    <button id="profileBtn" class="header-wide-btn btn btn-light rounded-4 d-flex justify-content-center align-items-center">
                        <span>Logged in as : Admin Name</span>
                    </button>
                    <a class="header-wide-btn btn btn-light rounded-4 d-flex justify-content-center align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                        <span>View site</span>
                    </a>
                </div>
            </div>
            <div class="d-flex gap-4 py-2">
                <a class="nav-link d-flex align-items-center gap-1" asp-area="Admin" asp-controller="Catalog" asp-action="Index">
                    <i class="bi bi-collection"></i>
                    <span>Catalog</span>
                </a>
                <a class="nav-link d-flex align-items-center gap-1" asp-area="Admin" asp-controller="Database" asp-action="Index">
                    <i class="bi bi-hdd-stack"></i>
                    <span>Database</span>
                </a>
                <a class="nav-link d-flex align-items-center gap-1" asp-area="Admin" asp-controller="Discounts" asp-action="Index">
                    <i class="bi bi-percent"></i>
                    <span>Discounts</span>
                </a>
                <a class="nav-link d-flex align-items-center gap-1" asp-area="Admin" asp-controller="Orders" asp-action="Index">
                    <i class="bi bi-bag-check"></i>
                    <span>Orders</span>
                </a>
                <a class="nav-link d-flex align-items-center gap-1" asp-area="Admin" asp-controller="Users" asp-action="Index">
                    <i class="bi bi-people"></i>
                    <span>Users</span>
                </a>
                <a class="nav-link d-flex align-items-center gap-1" asp-area="Admin" asp-controller="News" asp-action="Index">
                    <i class="bi bi-newspaper"></i>
                    <span>News</span>
                </a>
                <a class="nav-link d-flex align-items-center gap-1" asp-area="Admin" asp-controller="Actions" asp-action="Index">
                    <i class="bi bi-clock-history"></i>
                    <span>Changelog</span>
                </a>
            </div>
        </div>
    </header>
    <div class="container-fluid flex-fill main">
        <main role="main" class="mt-4">
            @RenderBody()
        </main>
    </div>

    <!-- Overlay -->
    <div id="overlay" class="overlay d-none position-fixed w-100 h-100"></div>

    <footer class="mt-auto border-top text-muted py-3 bg-white">
        <div class="container-fluid footer-inner">
            &copy; 2025 - bookspace
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/profile.js" asp-append-version="true"></script>
    <script src="~/js/cart.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
