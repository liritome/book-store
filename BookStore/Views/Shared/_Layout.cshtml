<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BookStore.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/logo.ico" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="header fixed-top bg-white">
        <div class="header-inner container-fluid">
            <div class="d-flex gap-2 align-items-center py-2 border-bottom">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" alt="BookStore Logo" class="logo" />
                </a>
                <div class="flex-fill ms-3">
                    <input type="search" class="search-product form-control rounded-5" placeholder="Search product" />
                </div>
                <div class="border-end px-3 text-nowrap">
                    Bonuses: 100
                </div>
                <div class="d-flex gap-2 ms-2">
                    <button id="profileBtn" class="btn btn-light rounded-4 d-flex justify-content-center align-items-center header-btn">
                        <i class="bi bi-person"></i>
                    </button>
                    <a class="btn btn-light rounded-4 d-flex justify-content-center align-items-center header-btn" asp-area="" asp-controller="Wishlist" asp-action="Index">
                        <i class="bi bi-heart"></i>
                    </a>
                    <button class="btn btn-light rounded-4 d-flex justify-content-center align-items-center header-btn">
                        <i class="bi bi-cart"></i>
                    </button>
                </div>
            </div>
            <div class="d-flex gap-4 py-2">
                <a class="nav-link" asp-controller="Catalog" asp-action="Index">Catalog</a>
                <a class="nav-link" asp-controller="Catalog" asp-action="Index">E-books</a>
                <a class="nav-link" asp-controller="Catalog" asp-action="Index">Preorders</a>
                <a class="nav-link" asp-controller="Catalog" asp-action="Index">Merch</a>
                <a class="nav-link" asp-controller="Catalog" asp-action="Index">Sale</a>
                <a class="nav-link" asp-controller="Authors" asp-action="Index">Authors</a>
                <a class="nav-link" asp-controller="Home" asp-action="News">News</a>
            </div>
        </div>
    </header>
    <div class="container-fluid flex-fill main">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    @* Profile panel *@
    <div id="overlay" class="overlay d-none position-fixed w-100 h-100"></div>
    <div id="profile" class="profile d-none  position-fixed h-100 bg-white overflow-y-auto">
        <div class="d-flex justify-content-between align-items-center px-4 py-3 border-bottom">
            <span class="profile-header">Profile</span>
            <button id="profileCloseBtn" class="btn-close"></button>
        </div>
        <div class="px-4 py-3">
            <div>
                <span class="profile-header-2">Bonuses</span>
            </div>
            <div class="mt-3 rounded-4 border border-1 p-2">
                <div class="d-flex gap-3 align-items-center">
                    <div class="profile-icon-big rounded-4 d-flex justify-content-center align-items-center">
                        <i class="bi bi-currency-bitcoin"></i>
                    </div>
                    <span class="profile-bonuses">100</span>
                </div>
            </div>
            <div class="mt-3 d-flex justify-content-between align-items-center">
                <span class="profile-header-2">Personal info</span>
                <a class="profile-button d-flex justify-content-center align-items-center btn btn-light rounded-5" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-pencil"></i>
                </a>
            </div>
            <div class="mt-3 rounded-4 border border-1 p-2">
                <div class="d-flex gap-3 align-items-center">
                    <div class="profile-icon-big rounded-4 d-flex justify-content-center align-items-center">
                        <i class="bi bi-person"></i>
                    </div>
                    <div class="d-flex flex-column gap-1">
                        <span class="profile-label text-muted">Name</span>
                        <span class="profile-value">Name</span>
                    </div>
                </div>
                <div class="d-flex gap-3 align-items-center border-top pt-2 mt-2">
                    <div class="profile-icon-big rounded-4 d-flex justify-content-center align-items-center">
                        <i class="bi bi-person"></i>
                    </div>
                    <div class="d-flex flex-column gap-1">
                        <span class="profile-label text-muted">Surname</span>
                        <span class="profile-value">Surname</span>
                    </div>
                </div>
                <div class="d-flex gap-3 align-items-center border-top pt-2 mt-2">
                    <div class="profile-icon rounded-4 d-flex justify-content-center align-items-center">
                        <i class="bi bi-calendar-event"></i>
                    </div>
                    <div class="d-flex flex-column gap-1">
                        <span class="profile-label text-muted">Date of birth</span>
                        <span class="profile-value">08.11.2000</span>
                    </div>
                </div>
                <div class="d-flex gap-3 align-items-center border-top pt-2 mt-2">
                    <div class="profile-icon rounded-4 d-flex justify-content-center align-items-center">
                        <i class="bi bi-envelope"></i>
                    </div>
                    <div class="d-flex flex-column gap-1">
                        <span class="profile-label text-muted">Email</span>
                        <span class="profile-value">emailaddress@gmail.com</span>
                    </div>
                </div>
                <div class="d-flex gap-3 align-items-center border-top pt-2 mt-2">
                    <div class="profile-icon rounded-4 d-flex justify-content-center align-items-center">
                        <i class="bi bi-telephone"></i>
                    </div>
                    <div class="d-flex flex-column gap-1">
                        <span class="profile-label text-muted">Phone numer</span>
                        <span class="profile-value">+380XXXXXXXXX</span>
                    </div>
                </div>
            </div>
            <div class="h-100 d-flex flex-column gap-3 mt-5">
                <a class="btn btn-secondary" asp-controller="Orders" asp-action="Index">
                    My orders
                </a>
                <a class="btn btn-secondary" asp-controller="Wishlist" asp-action="Index">
                    Wishlist
                </a>
                <a class="btn btn-danger" asp-controller="Home" asp-action="Index">
                    Log out
                </a>
            </div>
        </div>
    </div>

    <footer class="mt-auto border-top text-muted py-3 bg-white">
        <div class="container-fluid footer-inner">
            &copy; 2025 - bookspace
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/profile.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
