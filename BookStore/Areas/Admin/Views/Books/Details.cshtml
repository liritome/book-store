@{
    ViewData["Title"] = "Book details";
}

@{
    int id = 10001;
}

<div class="d-flex justify-content-between align-items-start">
    <div>
        <h2 class="mb-1">Book Title</h2>
        <div class="d-flex gap-2 align-items-center">
            <span class="border border-1 border-success bg-success-subtle text-success rounded-5 px-2">
                Visible
            </span>
            <span class="border border-1 border-secondary bg-secondary-subtle text-secondary rounded-5 px-2">
                Hidden
            </span>
            <span class="border border-1 border-primary bg-primary-subtle text-primary rounded-5 px-2">
                Scheduled
            </span>
            <span class="text-muted">ID: 10001</span>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a class="admin-details-button btn btn-primary d-flex justify-content-center align-items-center" asp-action="Edit" asp-route-id="10001">
            <i class="bi bi-pencil"></i>
            <span class="ms-1">Edit</span>
        </a>
        <form asp-action="ToggleVisibility" asp-route-id="@id" method="post">
            <button class="admin-details-button btn btn-success">
                <i class="bi bi-eye"></i>
                <span>Show</span>
            </button>
        </form>
        <form asp-action="ToggleVisibility" asp-route-id="@id" method="post">
            <button class="admin-details-button btn btn-secondary">
                <i class="bi bi-eye-slash"></i>
                <span>Hide</span>
            </button>
        </form>
        <form asp-action="Delete" asp-route-id="@id" method="post" onsubmit="return confirm('Delete this book?')">
            <button class="admin-details-button btn btn-danger">
                <i class="bi bi-trash"></i>
                <span>Delete</span>
            </button>
        </form>
    </div>
</div>

<div class="mt-3">
    <div class="row">
        <div class="col-lg-4">
            <div class="bg-white rounded-4 p-3 text-center">
                <img class="admin-book-image img-fluid mb-3" src="~/images/book-empty.png" />
                <div class="d-flex gap-3 overflow-x-auto p-2">
                    @for (int i = 0; i < 5; i++)
                    {
                        <img class="admin-book-image-small img-fluid" src="~/images/book-empty.png" />
                    }
                </div>
                <div class="list-group list-group-flush text-end">
                    <div class="list-group-item d-flex justify-content-between gap-3">
                        <span>Link</span>
                        <a class="text-muted border-bottom border-dark border-1" asp-area="" asp-controller="Catalog" asp-action="Details" asp-route-slug="book-title">
                            <span>Catalog/book-title</span>
                        </a>
                    </div>
                    <div class="list-group-item d-flex justify-content-between gap-3">
                        <span>Ebook</span>
                        <a class="text-muted" asp-controller="Books" asp-action="Details">
                            <i class="bi bi-box-arrow-up-right"></i>
                        </a>
                    </div>
                    <div class="list-group-item d-flex justify-content-between gap-3">
                        <span>ISBN</span>
                        <span class="text-muted">978-617-12-9941-2</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between gap-3">
                        <span>Title</span>
                        <span class="text-muted">Book title</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between gap-3">
                        <span>Author</span>
                        <a class="text-muted border-bottom border-dark border-1" asp-area="Admin" asp-controller="Authors" asp-action="Details" asp-route-slug="author-name">Author Name</a>
                    </div>
                    <div class="list-group-item d-flex justify-content-between gap-3">
                        <span>Series</span>
                        <a class="text-muted border-bottom border-dark border-1" asp-area="Admin" asp-controller="Series" asp-action="Details" asp-route-slug="series-name">Series Name</a>
                    </div>
                    <div class="list-group-item d-flex justify-content-between gap-3">
                        <span>Year</span>
                        <span class="text-muted">2025</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between gap-3">
                        <span>Publisher</span>
                        <a class="text-muted border-bottom border-dark border-1" asp-area="Admin" asp-controller="Publishers" asp-action="Details" asp-route-slug="publisher-name">Booklab Publishing Name</a>
                    </div>
                    <div class="list-group-item d-flex justify-content-between gap-3">
                        <span>Translator</span>
                        <a class="text-muted border-bottom border-dark border-1" asp-area="Admin" asp-controller="Translators" asp-action="Details" asp-route-slug="translator-name">Translator Name</a>
                    </div>
                    <div class="list-group-item d-flex justify-content-between gap-3">
                        <span>Language</span>
                        <span class="text-muted">Ukrainian</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between gap-3">
                        <span>Cover type</span>
                        <span class="text-muted">Hard cover</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between gap-3">
                        <span>Pages</span>
                        <span class="text-muted">418</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between gap-3">
                        <span>Size</span>
                        <span class="text-muted">160 x 220 x 32 mm</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between gap-3">
                        <span>Weight</span>
                        <span class="text-muted">300 g</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-8 mt-4 mt-lg-0">
            <div class="row">
                <div class="col-lg-6">
                    <div class="bg-white rounded-4 p-3">
                        <h6>Stock</h6>
                        <h3>10000</h3>
                        <small class="text-muted">Last restock: 11.12.2025 12:00:00</small>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="bg-white rounded-4 p-3 mt-4 mt-lg-0">
                        <div class="d-flex gap-2">
                            <div class="w-100">
                                <h6>Price</h6>
                                <h3>400 ₴</h3>
                            </div>
                            <div class="w-100">
                                <h6>Discount</h6>
                                <h3 class="text-success">10%</h3>
                            </div>
                            <div class="w-100">
                                <h6>Final price</h6>
                                <h3>360 ₴</h3>
                            </div>
                        </div>
                        <small class="text-muted">Discount valid until: 01.01.2026 0:00:00</small>
                    </div>
                </div>
            </div>
            <div class="bg-white rounded-4 p-3 mt-4">
                <h5>Tags</h5>
                <div class="d-flex flex-wrap gap-2 mt-3">
                    @for (int i = 0; i < 12; i++)
                    {
                        <a asp-area="Admin" asp-controller="Tags" asp-action="Details" asp-route-slug="tag-name">
                            <div class="bg-secondary-subtle px-2 py-1 rounded-5">
                                <span>Tag name</span>
                            </div>
                        </a>
                    }
                </div>
            </div>
            <div class="bg-white rounded-4 p-3 mt-4">
                <h5>Description</h5>
                <p class="mt-2">
                    Lorem ipsum dolor sit amet, consectetur adipiscing elit. Morbi ultrices velit orci, sed posuere mauris sagittis in. Maecenas turpis lectus,
                    convallis a accumsan commodo, luctus dapibus nunc. Proin vitae massa sed mauris tincidunt faucibus id ut dui. Duis ut velit euismod, auctor
                    turpis et, cursus metus. Vivamus auctor ligula finibus nisl gravida porttitor. Nulla pulvinar imperdiet augue ullamcorper congue. Aenean
                    posuere metus aliquet dui fermentum hendrerit. Lorem ipsum dolor sit amet, consectetur adipiscing elit. Pellentesque a felis at nulla
                    elementum aliquam ac et eros. Nullam lacinia hendrerit turpis, ut tempor justo condimentum id. Fusce hendrerit ullamcorper ornare. Duis
                    suscipit tortor est, eu congue ligula commodo sed. Nulla mattis id libero sit amet facilisis. Nulla ultricies magna nec tellus laoreet,
                    quis blandit purus laoreet. Cras non rutrum nisi. Pellentesque malesuada dapibus sapien, sit amet sodales elit tempus nec. Proin sagittis,
                    ante ut cursus dignissim, nunc risus rutrum eros, varius bibendum leo justo a urna. Aliquam sed mauris ut libero finibus fringilla id gravida
                    felis. Aliquam efficitur malesuada neque ornare laoreet. Aenean quam magna, vestibulum non odio et, tempus elementum diam. Vestibulum vitae
                    tellus facilisis, vestibulum ipsum in, lobortis odio. Sed leo erat, dapibus condimentum feugiat vel, congue vitae sem. Nunc at dignissim eros.
                    Nunc vel nunc id nisl fringilla sollicitudin in non justo. Fusce dignissim et orci a bibendum. Proin tristique ut nisl sed rutrum. Sed pulvinar
                    et lorem vel malesuada. Phasellus ultrices feugiat gravida. Orci varius natoque penatibus et magnis dis parturient montes, nascetur ridiculus
                    mus. Etiam vitae enim gravida, tristique neque at, gravida libero. Suspendisse ipsum eros, posuere eu augue nec, ullamcorper interdum enim.
                    Praesent eget dui porta, pharetra turpis non, tempor massa. Quisque lacus nunc, convallis quis sagittis eget, rutrum a enim.
                </p>
            </div>
            <div class="bg-white rounded-4 p-3 mt-4">
                <div class="d-flex align-items-center">
                    <div class="d-flex w-100">
                        <div class="w-50">
                            <h6>Rating</h6>
                            <div>
                                <i class="bi bi-star-fill text-warning"></i>
                                <span class="ms-1">4.2 / 5</span>
                            </div>
                        </div>
                        <div class="w-50">
                            <h6>Reviews</h6>
                            <div>
                                <i class="bi bi-chat-left-fill text-secondary"></i>
                                <span class="ms-1">12</span>
                            </div>
                        </div>
                        <div class="py-2 pe-2">
                            <button class="expand-button btn d-flex justify-content-center align-items-center" data-bs-toggle="collapse" data-bs-target="#reviewsCollapse">
                                <i class="bi bi-chevron-down"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="collapse border-top" id="reviewsCollapse">
                    <div class="d-flex flex-column">
                        @for (int j = 0; j < 4; j++)
                        {
                            <div class="border rounded-3 p-3 mt-3">
                                <div class="d-flex gap-2 align-items-center">
                                    <strong>User Name</strong>
                                    <div class="ms-auto d-flex gap-2">
                                        <span class="border border-1 border-success bg-success-subtle text-success rounded-5 px-2">
                                            New
                                        </span>
                                        <span class="border border-1 border-secondary bg-secondary-subtle text-secondary rounded-5 px-2">
                                            Hidden
                                        </span>
                                        <small class="text-muted">20.12.2025 14:00</small>
                                    </div>
                                </div>
                                <p>
                                    Very good book, enjoyed the story a lot.
                                </p>
                                <div class="d-flex gap-2 align-items-end">
                                    <div>
                                        <span class="pe-3 border-end">
                                            <i class="bi bi-star-fill text-warning"></i>
                                            <span class="ms-1">4.2 / 5</span>
                                        </span>
                                        <span class="ms-3 ">
                                            <i class="bi bi-hand-thumbs-up-fill text-secondary"></i>
                                            <span class="ms-1">+10</span>
                                        </span>
                                    </div>
                                    <div class="d-flex gap-2 ms-auto">
                                        <form asp-controller="Comments" asp-action="ToggleVisibility" asp-route-id="@id" method="post">
                                            <button class="admin-table-btn btn btn-success">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        </form>
                                        <form asp-controller="Comments" asp-action="ToggleVisibility" asp-route-id="@id" method="post">
                                            <button class="admin-table-btn btn btn-secondary">
                                                <i class="bi bi-eye-slash"></i>
                                            </button>
                                        </form>
                                        <form asp-controller="Comments" asp-action="Delete" asp-route-id="@id" method="post" onsubmit="return confirm('Delete this commant?')">
                                            <button class="admin-table-btn btn btn-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="p-3 mt-2">
        <ul class="list-unstyled mb-0">
            <li>
                <strong>Created:</strong>
                18.12.2025 18:00:00
                <strong class="ms-3">by:</strong>
                Admin Name
            </li>
            <li class="mt-1">
                <strong>Updated:</strong>
                18.12.2025 22:00:00
                <strong class="ms-3">by:</strong>
                Admin Name
            </li>
        </ul>
    </div>
</div>