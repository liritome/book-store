@{
    ViewData["Title"] = "Admin Books";
}

<div class="d-flex gap-2">
    <button class="btn btn-primary d-flex align-items-center gap-2">
        <i class="bi bi-plus-circle"></i>
        <span>Add Book</span>
    </button>
</div>
<div class="mt-3">
    <form class="d-flex flex-column gap-3" asp-action="Index" method="get">
        <div class="d-flex gap-3 align-items-end">
            <div>
                <label class="form-label">Search</label>
                <input name="q" type="text" class="admin-filter-input-l form-control" placeholder="Name, ID or ISBN">
            </div>
            <div>
                <label class="form-label">Status</label>
                <select name="status" class="form-select">
                    <option value="">All</option>
                    <option value="visible">Visible</option>
                    <option value="scheduled">Scheduled</option>
                    <option value="hidden">Hidden</option>
                </select>
            </div>
            <div>
                <label class="form-label">Type</label>
                <select name="type" class="form-select">
                    <option value="">All</option>
                    <option value="paper">Paper</option>
                    <option value="ebook">E-book</option>
                </select>
            </div>
            <div>
                <label class="form-label">Stock</label>
                <div class="d-flex gap-1">
                    <input name="stockFrom" type="number" min="0" class="admin-filter-input-m form-control" placeholder="">
                    <input name="stockTo" type="number" min="0" class="admin-filter-input-m form-control" placeholder="">
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Search</button>
        </div>
        <div class="d-flex gap-3 align-items-end">
            <div>
                <label class="form-label">Price</label>
                <div class="d-flex gap-1">
                    <input name="priceFrom" type="number" min="0" class="admin-filter-input-s form-control" placeholder="">
                    <input name="priceTo" type="number" min="0" class="admin-filter-input-s form-control" placeholder="">
                </div>
            </div>
            <div>
                <label class="form-label">Discount</label>
                <select name="discount" class="form-select">
                    <option value="">All</option>
                    <option value="yes">With discount</option>
                    <option value="no">No discount</option>
                </select>
            </div>
            <div>
                <label class="form-label">Final price</label>
                <div class="d-flex gap-1">
                    <input name="finalFrom" type="number" min="0" class="admin-filter-input-s form-control" placeholder="">
                    <input name="finalTo" type="number" min="0" class="admin-filter-input-s form-control" placeholder="">
                </div>
            </div>
        </div>
    </form>
    <table class="table admin-table align-middle mt-3">
        <thead>
            <tr>
                <th></th>
                <th>
                    <a asp-action="Index"
                       asp-route-sort="id"
                       asp-route-q="@Context.Request.Query["q"]"
                       asp-route-status="@Context.Request.Query["status"]"
                       asp-route-type="@Context.Request.Query["type"]"
                       asp-route-discount="@Context.Request.Query["discount"]">
                        ID
                    </a>
                </th>
                <th>Image</th>
                <th>
                    <a asp-action="Index"
                       asp-route-sort="name"
                       asp-route-q="@Context.Request.Query["q"]"
                       asp-route-status="@Context.Request.Query["status"]"
                       asp-route-type="@Context.Request.Query["type"]"
                       asp-route-discount="@Context.Request.Query["discount"]">
                        Name
                    </a>
                </th>
                <th>
                    <a asp-action="Index"
                       asp-route-sort="type"
                       asp-route-q="@Context.Request.Query["q"]"
                       asp-route-status="@Context.Request.Query["status"]"
                       asp-route-type="@Context.Request.Query["type"]"
                       asp-route-discount="@Context.Request.Query["discount"]">
                        Type
                    </a>
                </th>
                <th>
                    <a asp-action="Index"
                       asp-route-sort="isbn"
                       asp-route-q="@Context.Request.Query["q"]"
                       asp-route-status="@Context.Request.Query["status"]"
                       asp-route-type="@Context.Request.Query["type"]"
                       asp-route-discount="@Context.Request.Query["discount"]">
                        ISBN
                    </a>
                </th>
                <th>
                    <a asp-action="Index"
                       asp-route-sort="price"
                       asp-route-q="@Context.Request.Query["q"]"
                       asp-route-status="@Context.Request.Query["status"]"
                       asp-route-type="@Context.Request.Query["type"]"
                       asp-route-discount="@Context.Request.Query["discount"]">
                        Price
                    </a>
                </th>
                <th>
                    <a asp-action="Index"
                       asp-route-sort="discount"
                       asp-route-q="@Context.Request.Query["q"]"
                       asp-route-status="@Context.Request.Query["status"]"
                       asp-route-type="@Context.Request.Query["type"]"
                       asp-route-discount="@Context.Request.Query["discount"]">
                        Discount
                    </a>
                </th>
                <th>
                    <a asp-action="Index"
                       asp-route-sort="final"
                       asp-route-q="@Context.Request.Query["q"]"
                       asp-route-status="@Context.Request.Query["status"]"
                       asp-route-type="@Context.Request.Query["type"]"
                       asp-route-discount="@Context.Request.Query["discount"]">
                        Final
                    </a>
                </th>
                <th>
                    <a asp-action="Index"
                       asp-route-sort="stock"
                       asp-route-q="@Context.Request.Query["q"]"
                       asp-route-status="@Context.Request.Query["status"]"
                       asp-route-type="@Context.Request.Query["type"]"
                       asp-route-discount="@Context.Request.Query["discount"]">
                        Stock
                    </a>
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < 30; i++)
            {
                <tr>
                    <td class="admin-table-status">
                        @if (i % 3 == 0)
                        {
                            <div class="bg-primary-subtle"></div>
                        }
                        else if (i % 3 == 1)
                        {
                            <div class="bg-success-subtle"></div>
                        }
                        else
                        {
                            <div class="bg-secondary-subtle"></div>
                        }
                    </td>
                    <td>
                        <a class="text-primary" asp-area="Admin" asp-controller="Books" asp-action="Details">
                            @(10000 + i)
                        </a>
                    </td>
                    <td>
                        <img src="~/images/book-empty-small.png" class="admin-image" />
                    </td>
                    <td>Product Name</td>
                    <td>
                        @if (i % 2 == 0)
                        {
                            <span>paper</span>
                        }
                        else
                        {
                            <span>e-book</span>
                        }
                    </td>
                    <td>978-617-15-1745-5</td>
                    <td>400</td>
                    <td>
                        @if (i % 2 == 0)
                        {
                            <span>no</span>
                        }
                        else
                        {
                            <span>yes</span>
                        }
                    </td>
                    <td>360</td>
                    <td>20000</td>
                    <td>
                        <div class="d-flex gap-1">
                            <a class="admin-table-btn btn btn-primary" asp-area="Admin" asp-controller="Books" asp-action="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form
                                  asp-action="ToggleVisibility" asp-route-id="@i" method="post">
                                <button type="submit" class="admin-table-btn btn @(i % 2 == 0 ? "btn-secondary" : "btn-success")">
                                    <i class="bi @(i % 2 == 0 ? "bi-eye-slash" : "bi-eye")"></i>
                                </button>
                            </form>
                            <form
                                  asp-action="Delete" asp-route-id="@i" method="post">
                                <button type="submit" class="admin-table-btn btn btn-danger">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>