@{
    ViewData["Title"] = "Checkout";
}

<h2 class="mt-4">Checkout</h2>
<div class="mt-4 d-flex">
    <div class="checkout-left d-flex flex-column gap-4">
        <div class="checkout-shadow-light bg-white rounded-4 p-4">
            <h3>My cart (5)</h3>
            <div class="d-flex flex-column">
                @for (int i = 0; i < 5; i++)
                {
                    @await Html.PartialAsync("_CartItemElement");
                }
            </div>
        </div>
        <div class="checkout-shadow-light bg-white rounded-4 p-4">
            <h3>Delivery and payment</h3>
            <div>
                <div class="checkout-header pt-3">Recipient</div>
                <div class="d-flex pt-2">
                    <input type="text" class="form-control rounded-4" id="checkoutName" placeholder="Name *">
                    <input type="text" class="form-control rounded-4 ms-2" id="checkoutSurname" placeholder="Surname *">
                </div>
                <div class="d-flex pt-2">
                    <input type="text" class="form-control rounded-4" id="checkoutEmail" placeholder="Email">
                    <input type="text" class="form-control rounded-4 ms-2" id="checkoutPhone" placeholder="Phone number *">
                </div>
                <div class="checkout-header pt-4">Deliver to</div>
                <div class="d-flex pt-2">
                    <input type="text" class="form-control rounded-4" id="checkoutCity" placeholder="City *">
                    <input type="text" class="form-control rounded-4 ms-2" id="checkoutPostbranch" placeholder="Post branch *">
                </div>
                <div class="checkout-header pt-4">Payment method</div>
                <div class="d-flex flex-column pt-2">
                    <div class="form-check">
                        <input checked class="form-check-input" type="radio" name="checkoutPayment" id="checkoutByCard" />
                        <label class="form-check-label" for="checkoutByCard">Pay by card now</label>
                    </div>
                    <div class="form-check pt-2">
                        <input class="form-check-input" type="radio" name="checkoutPayment" id="checkoutOnDelivery" />
                        <label class="form-check-label" for="checkoutOnDelivery">Pay on delivery</label>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="checkout-right ms-4 position-relative">
        <div class="checkout-shadow-strong p-4 bg-white rounded-4 sticky-top">
            <div class="border-bottom pb-3">
                <div class="checkout-header">Use bonuses (100 available)</div>
                <div class="d-flex pt-2">
                    <input type="number" class="form-control rounded-4" id="checkoutDiscountAmount" placeholder="Amount">
                    <button class="btn btn-secondary rounded-4 ms-2">Apply</button>
                </div>
            </div>
            <div class="border-bottom pb-3">
                <div class="d-flex flex-column gap-2 mt-3">
                    <div class="d-flex justify-content-between">
                        <span>5 items for a total of:</span>
                        <span>2000 UAH</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span>Delivery cost:</span>
                        <span>80 UAH</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span>Bonuses used:</span>
                        <span>200 UAH</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span>Total:</span>
                        <span class="order-price-total">1880 UAH</span>
                    </div>
                </div>
                <div class="d-flex mt-3 rounded-4 bg-success-subtle border border-1 border-success-subtle px-3 py-2">
                    <span>You will receive bonuses:</span>
                    <span class="ps-1">+18</span>
                </div>
            </div>
            <a class="btn btn-success rounded-4 d-flex justify-content-center align-items-center mt-3 px-3 py-2" asp-controller="Checkout" asp-action="Submit">
                <span class="checkout-submit-total">1880 UAH</span>
                <span class="px-3">Submit order</span>
                <i class="cart-button-icon bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
</div>