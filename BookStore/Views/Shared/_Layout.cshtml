<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BookStore.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="header fixed-top bg-white">
        <div class="header-inner container-fluid">
            <div class="d-flex gap-2 align-items-center py-2 border-bottom">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" alt="BookStore Logo" class="logo" />
                </a>
                <div class="flex-fill ms-3">
                    <input type="search" class="search-product form-control rounded-5" placeholder="Search product" />
                </div>
                <div class="border-end px-3 text-nowrap">
                    Bonuses: 100
                </div>
                <div class="d-flex gap-2 ms-2">
                    <button class="btn btn-light rounded-4 d-flex justify-content-center align-items-center header-btn">
                        <i class="bi bi-person"></i>
                    </button>
                    <button class="btn btn-light rounded-4 d-flex justify-content-center align-items-center header-btn">
                        <i class="bi bi-heart"></i>
                    </button>
                    <button class="btn btn-light rounded-4 d-flex justify-content-center align-items-center header-btn">
                        <i class="bi bi-cart"></i>
                    </button>
                </div>
            </div>
            <div class="d-flex gap-4 py-2">
                <a class="nav-link" asp-controller="Catalog" asp-action="Index">Catalog</a>
                <a class="nav-link" asp-controller="Catalog" asp-action="Index">E-books</a>
                <a class="nav-link" asp-controller="Catalog" asp-action="Index">Preorders</a>
                <a class="nav-link" asp-controller="Catalog" asp-action="Index">Merch</a>
                <a class="nav-link" asp-controller="Catalog" asp-action="Index">Sale</a>
                <a class="nav-link" asp-controller="Authors" asp-action="Index">Authors</a>
                <a class="nav-link" asp-controller="Home" asp-action="News">News</a>
            </div>
        </div>
    </header>
    <div class="container-fluid flex-fill main">
        <main role="main">
            @RenderBody()
        </main>
    </div>
    <footer class="mt-auto border-top text-muted py-3 bg-white">
        <div class="container-fluid footer-inner">
            &copy; 2025 - bookspace
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
