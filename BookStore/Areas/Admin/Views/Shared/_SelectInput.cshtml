@model ISelectInputViewModel

<div>
    @if (!string.IsNullOrEmpty(Model.Label))
    {
        <label class="form-label">@Model.Label</label>
    }
    <div class="input-group">
        <input type="text" class="form-control" placeholder="@Model.Placeholder" oninput="filterItems(this)" />
        <button type="button" class="btn btn-outline-secondary" onclick="clearSearch(this)">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>
    <div class="dropdown-list mt-1">
        @foreach (var item in Model.Items)
        {
            <label class="dropdown-item">
                <input checked="@Model.SelectedIds!.Contains(Model.GetId(item))" type="checkbox"
                       name="@Model.Name" value="@Model.GetId(item)" class="form-check-input" />
                @Model.GetText(item)
            </label>
        }
    </div>
</div>

<script src="~/js/admin/selectInput.js"></script>
