@{
    ViewData["Title"] = "Book Name";
}

<div class="product mt-4">
    <div class="d-flex">
        <div class="product-top-left d-flex align-items-start gap-3 px-3">
            <div class="product-thumbnail overflow-y-auto h-100 d-flex flex-column gap-2 align-items-center pe-1">
                <img class="img-thumbnail" src="~/images/book-empty.png" />
                <img class="img-thumbnail" src="~/images/book-empty.png" />
                <img class="img-thumbnail" src="~/images/book-empty.png" />
                <img class="img-thumbnail" src="~/images/book-empty.png" />
                <img class="img-thumbnail" src="~/images/book-empty.png" />
                <img class="img-thumbnail" src="~/images/book-empty.png" />
            </div>
            <div class="product-image h-100 d-flex flex-grow-1 justify-content-center align-items-center">
                <img src="~/images/book-empty.png" />
            </div>
        </div>
        <div class="product-top-right ps-5">
            <div>
                <h1 class="">Book title</h1>
            </div>
            <div class="product-author mt-2">
                <a class="text-decoration-none text-reset" asp-area="" asp-controller="" asp-action="">Author name</a>
            </div>
            <div class="product-series d-flex gap-2 mt-2">
                <span>Series:</span>
                <a class="text-decoration-none text-reset" asp-area="" asp-controller="" asp-action="">Series name</a>
            </div>
            <div class="product-rating d-flex gap-4 mt-2">
                <div class="product-score position-relative">
                    <div class="star-bg">
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                    </div>
                    <div class="star-fg" style="width: 75%">
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                    </div>
                </div>
                <div class="product-reviews d-flex align-items-center gap-1">
                    <span>12</span>
                    <i class="bi bi-chat-left-fill"></i>
                </div>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                <span>Tags:</span>
                @for (int i = 0; i < 8; i++)
                {
                    <a class="product-tag bg-secondary bg-se rounded-5 px-2 py-1 text-decoration-none text-reset" asp-area="" asp-controller="" asp-action="">Tag name</a>
                }
            </div>
            <div class="d-flex gap-1 mt-3">
                <div class="d-flex gap-2 p-2 border-end">
                    <i class="bi bi-book"></i>
                    <span>hard cover</span>
                </div>
                <div class="d-flex gap-2 p-2 border-end">
                    <i class="bi bi-file-earmark"></i>
                    <span>418 pages</span>
                </div>
                <div class="d-flex gap-2 p-2">
                    <i class="bi bi-arrows-fullscreen"></i>
                    <span>160 x 220 x 32 mm</span>
                </div>
            </div>
            <div class="product-buy px-4 p-4 rounded-4 mt-2">
                <div class="product-types d-flex gap-2">
                    <button class="btn w-100 btn-outline-dark btn rounded-4">
                        <div>
                            <span>Paper book</span>
                        </div>
                        <div>
                            <span>720 UAH</span>
                        </div>
                    </button>
                    <button class="btn w-100 btn-outline-dark rounded-4">
                        <div>
                            <span>E-book</span>
                        </div>
                        <div>
                            <span>380 UAH</span>
                        </div>
                    </button>
                </div>
                <div class="mt-4">
                    <div class="product-stock text-success d-flex align-items-center">
                        <i class="bi bi-check"></i>
                        <span>In stock</span>
                    </div>
                    <div class="product-stock text-danger d-flex align-items-center d-none">
                        <i class="bi bi-x"></i>
                        <span>Out of stock</span>
                    </div>
                    <div class="d-flex gap-2 align-items-end">
                        <span class="product-final-price">680 UAH</span>
                        <span class="product-main-price mb-1">720 UAH</span>
                    </div>
                    <div class="mt-2">
                        <span class="text-success bg-success-subtle rounded-5 px-2 py-1">+6.8 bonuses</span>
                    </div>
                    <div class="d-flex gap-2 mt-3">
                        <button class="buy-button-big btn btn-success flex-grow-1 rounded-4 d-flex gap-2 justify-content-center align-items-center">
                            <i class="bi bi-cart"></i>
                            <span>Buy</span>
                        </button>
                        <button class="wish-button btn btn-light rounded-4 d-flex justify-content-center align-items-center">
                            <i class="bi bi-heart-fill"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="d-flex mt-4 w-100 rounded-4 bg-white">
        <div class="product-bottom-left p-3 border-end">
            <h4 class="mb-3">Product details</h4>
            <div class="list-group list-group-flush">
                <div class="list-group-item d-flex justify-content-between gap-3">
                    <span>ISBN</span>
                    <span class="text-muted">978-617-12-9941-2</span>
                </div>
                <div class="list-group-item d-flex justify-content-between gap-3">
                    <span>Title</span>
                    <span class="text-muted">Book title</span>
                </div>
                <div class="list-group-item d-flex justify-content-between gap-3">
                    <span>Author</span>
                    <span class="text-muted">Author Name</span>
                </div>
                <div class="list-group-item d-flex justify-content-between gap-3">
                    <span>Series</span>
                    <span class="text-muted">Series Name</span>
                </div>
                <div class="list-group-item d-flex justify-content-between gap-3">
                    <span>Year</span>
                    <span class="text-muted">2025</span>
                </div>
                <div class="list-group-item d-flex justify-content-between gap-3">
                    <span>Publishing</span>
                    <span class="text-muted">Booklab Publishing Name</span>
                </div>
                <div class="list-group-item d-flex justify-content-between gap-3">
                    <span>Translator</span>
                    <span class="text-muted">Translator Name</span>
                </div>
                <div class="list-group-item d-flex justify-content-between gap-3">
                    <span>Language</span>
                    <span class="text-muted">Ukrainian</span>
                </div>
                <div class="list-group-item d-flex justify-content-between gap-3">
                    <span>Cover type</span>
                    <span class="text-muted">Hard cover</span>
                </div>
                <div class="list-group-item d-flex justify-content-between gap-3">
                    <span>Pages</span>
                    <span class="text-muted">418</span>
                </div>
                <div class="list-group-item d-flex justify-content-between gap-3">
                    <span>Size</span>
                    <span class="text-muted">160 x 220 x 32 mm</span>
                </div>
                <div class="list-group-item d-flex justify-content-between gap-3">
                    <span>Weight</span>
                    <span class="text-muted">300 g</span>
                </div>
            </div>
        </div>
        <div class="product-bottom-right p-3">
            <h4>About</h4>
            <p class="mt-3">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Morbi ultrices velit orci, sed posuere mauris sagittis in. Maecenas turpis lectus, convallis a accumsan commodo, luctus dapibus nunc. Proin vitae massa sed mauris tincidunt faucibus id ut dui. Duis ut velit euismod, auctor turpis et, cursus metus. Vivamus auctor ligula finibus nisl gravida porttitor. Nulla pulvinar imperdiet augue ullamcorper congue. Aenean posuere metus aliquet dui fermentum hendrerit. Lorem ipsum dolor sit amet, consectetur adipiscing elit. Pellentesque a felis at nulla elementum aliquam ac et eros. Nullam lacinia hendrerit turpis, ut tempor justo condimentum id. Fusce hendrerit ullamcorper ornare. Duis suscipit tortor est, eu congue ligula commodo sed. Nulla mattis id libero sit amet facilisis. Nulla ultricies magna nec tellus laoreet, quis blandit purus laoreet. Cras non rutrum nisi. Pellentesque malesuada dapibus sapien, sit amet sodales elit tempus nec. Proin sagittis, ante ut cursus dignissim, nunc risus rutrum eros, varius bibendum leo justo a urna. Aliquam sed mauris ut libero finibus fringilla id gravida felis. Aliquam efficitur malesuada neque ornare laoreet. Aenean quam magna, vestibulum non odio et, tempus elementum diam. Vestibulum vitae tellus facilisis, vestibulum ipsum in, lobortis odio. Sed leo erat, dapibus condimentum feugiat vel, congue vitae sem. Nunc at dignissim eros. Nunc vel nunc id nisl fringilla sollicitudin in non justo. Fusce dignissim et orci a bibendum. Proin tristique ut nisl sed rutrum. Sed pulvinar et lorem vel malesuada. Phasellus ultrices feugiat gravida. Orci varius natoque penatibus et magnis dis parturient montes, nascetur ridiculus mus. Etiam vitae enim gravida, tristique neque at, gravida libero. Suspendisse ipsum eros, posuere eu augue nec, ullamcorper interdum enim. Praesent eget dui porta, pharetra turpis non, tempor massa. Quisque lacus nunc, convallis quis sagittis eget, rutrum a enim.</p>
        </div>
    </div>
    <div class="reviews-container mt-3">
        <div class="d-flex justify-content-between align-items-center">
            <h4 class="p-3 m-0">Reviews</h4>
            <button class="btn btn-outline-dark rounded-4 px-4 py-2">
                <span>Add review</span>
            </button>
        </div>
        <div class="reviews-container-inner overflow-auto mt-3 d-flex flex-column gap-3 pe-2">
            @for(int i = 0; i < 10; i++)
            {
                <div class="review bg-white rounded-4 p-3">
                    <div class="d-flex justify-content-between">
                        <span>User Name</span>
                        <div class="review-score position-relative">
                            <div class="star-bg">
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                            </div>
                            <div class="star-fg" style="width: 75%">
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                            </div>
                        </div>
                    </div>
                    <div class="text-muted">30.10.2025</div>
                    <p class="mt-2">Duis suscipit tortor est, eu congue ligula commodo sed. Nulla mattis id libero sit amet facilisis. Nulla ultricies magna nec tellus laoreet, quis blandit purus laoreet. Cras non rutrum nisi. Pellentesque malesuada dapibus sapien, sit amet sodales elit tempus nec. Proin sagittis, ante ut cursus dignissim, nunc risus rutrum eros, varius bibendum leo justo a urna. Aliquam sed mauris ut libero finibus fringilla id gravida felis. Aliquam efficitur malesuada neque ornare laoreet. Aenean quam magna, vestibulum non odio et, tempus elementum diam. Vestibulum vitae tellus facilisis, vestibulum ipsum in, lobortis odio. Sed leo erat, dapibus condimentum feugiat vel, congue vitae sem. Nunc at dignissim eros. Nunc vel nunc id nisl fringilla sollicitudin in non justo. Fusce dignissim et orci a bibendum.</p>
                    <div class="review-likes d-flex gap-3 justify-content-end align-items-center">
                        <div class="d-flex justify-content-between gap-2 align-items-center">
                            <span class="review-muted text-muted">Review rating:</span>
                            <span class="review-number text-success">10</span>
                        </div>
                        <button class="review-button btn btn-light rounded-4 d-flex justify-content-center align-items-center">
                            <i class="bi bi-hand-thumbs-up-fill"></i>
                        </button>
                        <button class="review-button btn btn-light rounded-4 d-flex justify-content-center align-items-center">
                            <i class="bi bi-hand-thumbs-down-fill"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>