@{
    ViewData["Title"] = "Book details";
}

@model Book

<div class="d-flex justify-content-between align-items-start">
    <div>
        <h2 class="mb-1">@Model.Title</h2>
        <div class="d-flex gap-2 align-items-center">
            @if (Model.IsVisible)
            {
                <span class="border border-1 border-success bg-success-subtle text-success rounded-5 px-2">
                    Visible
                </span>
            }
            else
            {
                <span class="border border-1 border-secondary bg-secondary-subtle text-secondary rounded-5 px-2">
                    Hidden
                </span>
                <span class="border border-1 border-primary bg-primary-subtle text-primary rounded-5 px-2">
                    Scheduled -
                    <small>
                        <strong>
                            13.01.2026 12:00
                        </strong>
                    </small>
                </span>
            }
            <span class="text-muted">ID: @Model.Id</span>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a class="admin-details-button btn btn-primary d-flex justify-content-center align-items-center" asp-action="Edit" asp-route-id="@Model.Id">
            <i class="bi bi-pencil"></i>
            <span class="ms-1">Edit</span>
        </a>
        @if (!Model.IsVisible)
        {
            <form asp-action="ToggleVisibility" asp-route-id="@Model.Id" method="post">
                <button class="admin-details-button btn btn-success">
                    <i class="bi bi-eye"></i>
                    <span>Show</span>
                </button>
            </form>
        }
        else
        {
            <form asp-action="ToggleVisibility" asp-route-id="@Model.Id" method="post">
                <button class="admin-details-button btn btn-secondary">
                    <i class="bi bi-eye-slash"></i>
                    <span>Hide</span>
                </button>
            </form>
        }
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Delete @Model.Title (ID: @Model.Id)?')">
            <button class="admin-details-button btn btn-danger">
                <i class="bi bi-trash"></i>
                <span>Delete</span>
            </button>
        </form>
    </div>
</div>

<div class="mt-3">
    <div class="row">
        <div class="col-lg-4">
            <div class="bg-white rounded-4 p-3">
                <div class="text-center">
                    <img class="admin-book-image img-fluid mb-3" src="~/images/book-empty.png" />
                    <div class="d-flex gap-3 overflow-x-auto p-2">
                        @for (int i = 0; i < 5; i++)
                        {
                            <img class="admin-book-image-small img-fluid" src="~/images/book-empty.png" />
                        }
                    </div>
                </div>
                <div class="mt-4">
                    <div>
                        <h5>Details</h5>
                    </div>
                    <div class="list-group list-group-flush text-end">
                        <div class="list-group-item d-flex justify-content-between gap-3">
                            <span>Title</span>
                            <span class="text-muted">
                                @Model.Title
                            </span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between gap-3">
                            <span>Author</span>
                            <a class="text-muted border-bottom border-dark border-1" asp-area="Admin" asp-controller="Authors" asp-action="Details" asp-route-slug="author-name">
                                @Model.Authors.FirstOrDefault()?.Name
                            </a>
                        </div>
                        <div class="list-group-item d-flex justify-content-between gap-3">
                            <span>Series</span>
                            <a class="text-muted border-bottom border-dark border-1" asp-area="Admin" asp-controller="Series" asp-action="Details" asp-route-slug="series-name">
                                @Model.Series?.Name
                            </a>
                        </div>
                        <div class="list-group-item d-flex justify-content-between gap-3">
                            <span>Number in series</span>
                            <span class="text-muted">
                                @Model.NumberInSeries
                            </span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between gap-3">
                            <span>Year</span>
                            <span class="text-muted">
                                @Model.Year
                            </span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between gap-3">
                            <span>Publisher</span>
                            <a class="text-muted border-bottom border-dark border-1" asp-area="Admin" asp-controller="Publishers" asp-action="Details" asp-route-slug="publisher-name">
                                @Model.Publisher?.Name
                            </a>
                        </div>
                        <div class="list-group-item d-flex justify-content-between gap-3">
                            <span>Translator</span>
                            <a class="text-muted border-bottom border-dark border-1" asp-area="Admin" asp-controller="Translators" asp-action="Details" asp-route-slug="translator-name">
                                @Model.Translators.FirstOrDefault()?.Name
                            </a>
                        </div>
                        <div class="list-group-item d-flex justify-content-between gap-3">
                            <span>Language</span>
                            <span class="text-muted">
                                @Model.Language?.Name
                            </span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between gap-3">
                            <span>Has ebook</span>
                            <span class="text-muted">
                                @if (Model.DigitalBook != null)
                                {
                                    <i class="bi bi-check"></i>
                                }
                                else
                                {
                                    <i class="bi bi-x"></i>
                                }
                            </span>
                        </div>
                    </div>
                </div>
                <div class="mt-2">
                    <div>
                        <h5>Physical details</h5>
                    </div>
                    <div class="list-group list-group-flush text-end">
                        <div class="list-group-item d-flex justify-content-between gap-3">
                            <span>Link</span>
                            <a class="text-muted border-bottom border-dark border-1" asp-area="" asp-controller="Catalog" asp-action="Details" asp-route-slug="@Model.PhysicalBook?.Slug">
                                <span>Catalog/@Model.PhysicalBook?.Slug</span>
                            </a>
                        </div>
                        <div class="list-group-item d-flex justify-content-between gap-3">
                            <span>ISBN</span>
                            <span class="text-muted">@Model.PhysicalBook?.Isbn</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between gap-3">
                            <span>Cover type</span>
                            <span class="text-muted">
                                @(Model.PhysicalBook?.CoverType == CoverType.Hardcover ? "Hard cover" : "Paperback")
                            </span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between gap-3">
                            <span>Pages</span>
                            <span class="text-muted">@Model.PhysicalBook?.Pages</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between gap-3">
                            <span>Size</span>
                            <span class="text-muted">
                                @Model.PhysicalBook?.Width x @Model.PhysicalBook?.Height x @Model.PhysicalBook?.Thickness mm
                            </span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between gap-3">
                            <span>Weight</span>
                            <span class="text-muted">@Model.PhysicalBook?.Weight g</span>
                        </div>
                    </div>
                </div>
                <div class="mt-2 @(Model.DigitalBook == null ? "d-none" : "")">
                    <div>
                        <h5>Ebook details</h5>
                    </div>
                    <div class="list-group list-group-flush text-end">
                        <div class="list-group-item d-flex justify-content-between gap-3">
                            <span>Link</span>
                            <a class="text-muted border-bottom border-dark border-1" asp-area="" asp-controller="Catalog" asp-action="Details" asp-route-slug="@Model.DigitalBook?.Slug">
                                <span>Catalog/@Model.DigitalBook?.Slug</span>
                            </a>
                        </div>
                        <div class="list-group-item d-flex justify-content-between gap-3">
                            <span>ISBN</span>
                            <span class="text-muted">@Model.DigitalBook?.Isbn</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between gap-3">
                            <span>File</span>
                            <span class="text-muted">/ebooks/@Model.DigitalBook?.FileName</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-8 mt-4 mt-lg-0">
            <h5 class="">Physical stock and pricing</h5>
            <div class="row mt-2">
                <div class="col-lg-6">
                    <div class="bg-white rounded-4 p-3">
                        <div class="d-flex gap-2">
                            <div class="w-100">
                                <h6>Price</h6>
                                <h3>@Model.PhysicalBook?.Price ₴</h3>
                            </div>
                            <div class="w-100">
                                <h6>Discount</h6>
                                <h3 class="text-success">@Model.PhysicalBook?.Discount?.Percentage%</h3>
                            </div>
                            <div class="w-100">
                                <h6>Final price</h6>
                                <h3>@Model.PhysicalBook?.FinalPrice ₴</h3>
                            </div>
                        </div>
                        <small class="text-muted">Discount valid: @Model.PhysicalBook?.Discount?.ValidFrom - @Model.PhysicalBook?.Discount?.ValidTo</small>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="bg-white rounded-4 p-3 mt-3 mt-lg-0">
                        <h6>Stock</h6>
                        <div class="d-flex align-items-center">
                            <h3>@Model.PhysicalBook?.Stock</h3>
                            <div class="ms-4">
                                @if (Model.PhysicalBook?.IsAvailable == true)
                                {
                                    <span>
                                        <i class="bi bi-check"></i>
                                    </span>
                                    <span>Available</span>
                                }
                                else
                                {
                                    <span>
                                        <i class="bi bi-x"></i>
                                    </span>
                                    <span>Not available</span>
                                }
                            </div>
                        </div>
                        <small class="text-muted">Last restock: 11.12.2025 12:00:00</small>
                    </div>
                </div>
            </div>
            <div class="@(Model.DigitalBook == null ? "d-none" : "")">
                <h5 class="mt-4">Ebook stock and pricing</h5>
                <div class="row mt-2">
                    <div class="col-lg-6">
                        <div class="bg-white rounded-4 p-3">
                            <div class="d-flex gap-2">
                                <div class="w-100">
                                    <h6>Price</h6>
                                    <h3>@Model.DigitalBook?.Price ₴</h3>
                                </div>
                                <div class="w-100">
                                    <h6>Discount</h6>
                                    <h3 class="text-success">@Model.DigitalBook?.Discount?.Percentage%</h3>
                                </div>
                                <div class="w-100">
                                    <h6>Final price</h6>
                                    <h3>@Model.DigitalBook?.FinalPrice ₴</h3>
                                </div>
                            </div>
                            <small class="text-muted">Discount valid: @Model.DigitalBook?.Discount?.ValidFrom - @Model.DigitalBook?.Discount?.ValidTo</small>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="bg-white rounded-4 h-lg-100 p-3 mt-3 mt-lg-0">
                            <h6>Stock</h6>
                            <div class="d-flex">
                                <div>
                                    @if (Model.DigitalBook?.IsAvailable == true)
                                    {
                                        <span>
                                            <i class="bi bi-check"></i>
                                        </span>
                                        <span>Available</span>
                                    }
                                    else
                                    {
                                        <span>
                                            <i class="bi bi-x"></i>
                                        </span>
                                        <span>Not available</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="bg-white rounded-4 p-3 mt-4">
                <h5>Tags</h5>
                <div class="d-flex flex-wrap gap-2 mt-3">
                    @for (int i = 0; i < 12; i++)
                    {
                        <a asp-area="Admin" asp-controller="Tags" asp-action="Details" asp-route-slug="tag-name">
                            <div class="bg-secondary-subtle px-2 py-1 rounded-5">
                                <span>Tag name</span>
                            </div>
                        </a>
                    }
                </div>
            </div>
            <div class="bg-white rounded-4 p-3 mt-4">
                <h5>Description</h5>
                <p class="mt-2">
                    @Model.Description
                </p>
            </div>
            <div class="bg-white rounded-4 p-3 mt-4">
                <div class="d-flex align-items-center">
                    <div class="d-flex w-100">
                        <div class="w-50">
                            <h6>Rating</h6>
                            <div>
                                <i class="bi bi-star-fill text-warning"></i>
                                <span class="ms-1">@Model.Rating / 5</span>
                            </div>
                        </div>
                        <div class="w-50">
                            <h6>Reviews</h6>
                            <div>
                                <i class="bi bi-chat-left-fill text-secondary"></i>
                                <span class="ms-1">@Model.Reviews.Count()</span>
                            </div>
                        </div>
                        <div class="py-2 pe-2">
                            <button class="expand-button btn d-flex justify-content-center align-items-center" data-bs-toggle="collapse" data-bs-target="#reviewsCollapse">
                                <i class="bi bi-chevron-down"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="collapse border-top" id="reviewsCollapse">
                    <div class="d-flex flex-column">
                        @foreach (Review review in Model.Reviews)
                        {
                            <div class="border rounded-3 p-3 mt-3">
                                <div class="d-flex gap-2 align-items-center">
                                    <strong>@review.User.Name</strong>
                                    <div class="ms-auto d-flex gap-2">
                                        <span class="border border-1 border-success bg-success-subtle text-success rounded-5 px-2">
                                            New
                                        </span>
                                        <span class="border border-1 border-secondary bg-secondary-subtle text-secondary rounded-5 px-2">
                                            Hidden
                                        </span>
                                        <small class="text-muted">@review.Date</small>
                                    </div>
                                </div>
                                <p>
                                    @review.Text
                                </p>
                                <div class="d-flex gap-2 align-items-end">
                                    <div>
                                        <span class="pe-3 border-end">
                                            <i class="bi bi-star-fill text-warning"></i>
                                            <span class="ms-1">@review.Rating / 5</span>
                                        </span>
                                        <span class="ms-3 ">
                                            <i class="bi bi-hand-thumbs-up-fill text-secondary"></i>
                                            <span class="ms-1">@review.Likes</span>
                                        </span>
                                    </div>
                                    <div class="d-flex gap-2 ms-auto">
                                        <form asp-controller="Comments" asp-action="ToggleVisibility" asp-route-id="@review.Id" method="post">
                                            <button class="admin-table-btn btn btn-success">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        </form>
                                        <form asp-controller="Comments" asp-action="ToggleVisibility" asp-route-id="@review.Id" method="post">
                                            <button class="admin-table-btn btn btn-secondary">
                                                <i class="bi bi-eye-slash"></i>
                                            </button>
                                        </form>
                                        <form asp-controller="Comments" asp-action="Delete" asp-route-id="@review.Id" method="post" onsubmit="return confirm('Delete this commant?')">
                                            <button class="admin-table-btn btn btn-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="p-3 mt-2">
        <ul class="list-unstyled mb-0">
            <li>
                <strong>Created:</strong>
                18.12.2025 18:00:00
                <strong class="ms-3">by:</strong>
                Admin Name
            </li>
            <li class="mt-1">
                <strong>Updated:</strong>
                18.12.2025 22:00:00
                <strong class="ms-3">by:</strong>
                Admin Name
            </li>
        </ul>
    </div>
</div>