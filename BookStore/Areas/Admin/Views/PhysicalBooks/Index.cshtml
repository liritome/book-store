@model PhysicalBookIndexViewModel

@{
    ViewData["Title"] = "Books";
}

<div class="d-flex">
    <div class="admin-table-left">

        <!-- Add new book button -->
        <div class="d-flex gap-2">
            <a asp-action="Add" class="btn btn-primary d-flex align-items-center gap-2">
                <i class="bi bi-plus-circle"></i>
                <span>Add Book</span>
            </a>
        </div>

        <!-- Pagination top -->
        <div class="mt-2 d-flex justify-content-start">
            <div>
                <div class="mb-2">
                    Showing @Model.PageViewModel.GetLowerPageRange-@Model.PageViewModel.GetUpperPageRange of @Model.PageViewModel.TotalItems books
                </div>
                @await Html.PartialAsync("_Pagination", new PaginationViewModel
                    {
                        PageViewModel = Model.PageViewModel,
                        Filter = Model.Filter,
                        Sort = Model.Sort,
                        Area = "Admin",
                        Controller = "PhysicalBooks",
                        Action = "Index"
                    })
            </div>
        </div>

        <!-- Table -->
        <div class="bg-white rounded-4 overflow-auto">
            <table class="table table-fixed align-middle mt-3">
                <colgroup>
                    <col style="width: 1%"> <!-- visibility -->
                    <col style="width: 7%"> <!-- Id -->
                    <col style="width: 5%"> <!-- image -->
                    <col style="width: 19%"> <!-- title -->
                    <col style="width: 10%"> <!-- cover type -->
                    <col style="width: 13%"> <!-- isbn -->
                    <col style="width: 7%"> <!-- price -->
                    <col style="width: 10%"> <!-- discount -->
                    <col style="width: 7%"> <!-- final price -->
                    <col style="width: 6%"> <!-- stock -->
                    <col style="width: 15%"> <!-- action buttons -->
                </colgroup>
                <thead>
                    <tr>
                        <th></th>
                        <th>
                            <sortable-header
                                display-name="ID"
                                sort-by="@Model.IdSort"
                                current-sort="@Model.Sort"
                                sort-asc="@PhysicalBookSortState.IdAsc"
                                sort-desc="@PhysicalBookSortState.IdDesc"
                                filter="@Model.Filter"
                                controller="PhysicalBooks"
                                action="Index">
                            </sortable-header>
                        </th>
                        <th></th>
                        <th>
                            <sortable-header
                                display-name="Title"
                                sort-by="@Model.TitleSort"
                                current-sort="@Model.Sort"
                                sort-asc="@PhysicalBookSortState.TitleAsc"
                                sort-desc="@PhysicalBookSortState.TitleDesc"
                                filter="@Model.Filter"
                                controller="PhysicalBooks"
                                action="Index">
                            </sortable-header>
                        </th>
                        <th>
                            <sortable-header
                                display-name="Cover"
                                sort-by="@Model.CoverSort"
                                current-sort="@Model.Sort"
                                sort-asc="@PhysicalBookSortState.CoverAsc"
                                sort-desc="@PhysicalBookSortState.CoverDesc"
                                filter="@Model.Filter"
                                controller="PhysicalBooks"
                                action="Index">
                            </sortable-header>
                        </th>
                        <th>
                            <sortable-header 
                                display-name="ISBN"
                                sort-by="@Model.IsbnSort"
                                current-sort="@Model.Sort"
                                sort-asc="@PhysicalBookSortState.IsbnAsc"
                                sort-desc="@PhysicalBookSortState.IsbnDesc"
                                filter="@Model.Filter"
                                controller="PhysicalBooks"
                                action="Index">
                            </sortable-header>
                        </th>
                        <th>
                            <sortable-header 
                                display-name="Price"
                                sort-by="@Model.PriceSort"
                                current-sort="@Model.Sort"
                                sort-asc="@PhysicalBookSortState.PriceAsc"
                                sort-desc="@PhysicalBookSortState.PriceDesc"
                                filter="@Model.Filter"
                                controller="PhysicalBooks"
                                action="Index">
                            </sortable-header>
                        </th>
                        <th>
                            <sortable-header 
                                display-name="Discount"
                                sort-by="@Model.DiscountSort"
                                current-sort="@Model.Sort"
                                sort-asc="@PhysicalBookSortState.DiscountAsc"
                                sort-desc="@PhysicalBookSortState.DiscountDesc"
                                filter="@Model.Filter"
                                controller="PhysicalBooks"
                                action="Index">
                            </sortable-header>
                        </th>
                        <th>
                            <sortable-header 
                                display-name="Final"
                                sort-by="@Model.FinalPriceSort"
                                current-sort="@Model.Sort"
                                sort-asc="@PhysicalBookSortState.FinalPriceAsc"
                                sort-desc="@PhysicalBookSortState.FinalPriceDesc"
                                filter="@Model.Filter"
                                controller="PhysicalBooks"
                                action="Index">
                            </sortable-header>
                        </th>
                        <th>
                            <sortable-header 
                                display-name="Stock"
                                sort-by="@Model.StockSort"
                                current-sort="@Model.Sort"
                                sort-asc="@PhysicalBookSortState.StockAsc"
                                sort-desc="@PhysicalBookSortState.StockDesc"
                                filter="@Model.Filter"
                                controller="PhysicalBooks"
                                action="Index">
                            </sortable-header>
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var book in Model.Books)
                    {
                        <tr>
                            <td class="admin-table-status">
                                @if (book.IsVisible)
                                {
                                    <div class="bg-success-subtle"></div>
                                }
                                else
                                {
                                    <div class="bg-secondary-subtle"></div>
                                }
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@book.Id" class="text-primary">
                                    @book.Id
                                </a>
                            </td>
                            <td>
                                @if (book.Images.Count > 0)
                                {
                                    <img src="~/images/productImages/@book.OrderedImages.FirstOrDefault()?.Url" class="admin-image" />
                                }
                                else
                                {
                                    <img src="~/images/book-empty-small.png" class="admin-image" />
                                }
                            </td>
                            <td>
                                <span class="data-long" title="@book.Name">
                                    @book.Name
                                </span>
                            </td>
                            <td>
                                @(book.CoverType == CoverType.Hardcover ? "Hardcover" : "Paperback")
                            </td>
                            <td>@book.Isbn</td>
                            <td>@book.Price ₴</td>
                            <td class="text-center">
                                @if (book.DiscountId == null)
                                {
                                    <i class="admin-book-discount-icon bi bi-x text-danger"></i>
                                }
                                else
                                {
                                    <span class="text-success">@book.Discount?.Display()</span>
                                }
                            </td>
                            <td>@book.FinalPrice ₴</td>
                            <td>@book.Stock</td>
                            <td>
                                <div class="d-flex gap-1 justify-content-end">
                                    <a asp-action="Edit" asp-route-id="@book.Id" class="admin-table-btn btn btn-primary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="ToggleVisibility" asp-route-id="@book.Id" method="post">
                                        @if (book.IsVisible)
                                        {
                                            <button type="submit" class="admin-table-btn btn btn-secondary">
                                                <i class="bi bi-eye-slash"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="admin-table-btn btn btn-success">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        }
                                    </form>
                                    <form asp-action="Delete" asp-route-id="@book.Id" method="post"
                                          onsubmit="return confirm('Delete @book.Name (ID: @book.Id)?')">
                                        <button type="submit" class="admin-table-btn btn btn-danger">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Filters -->
    <div class="admin-table-right ms-4 position-relative">
        <div class="admin-table-filter bg-white rounded-4 sticky-top">
            <form asp-action="Index" method="get">
                <div class="admin-table-filter-scrollable d-flex flex-column overflow-y-auto">
                    <div>
                        <label class="form-label">Book</label>
                        <input name="Query" type="text" class="form-control" placeholder="Title, Series, ISBN or ID"
                               value="@Model.Filter.Query">
                    </div>
                    <div>
                        @await Html.PartialAsync("_SelectInput", new SelectInputViewModel
                            {
                                EntityName = "author",
                                FieldName = "AuthorIds",
                                Header = "Authors",
                                InputContainerPlaceholder = "Name",
                                SelectedIds = Model.Filter.AuthorIds,
                                SearchByQueryUrl = Url.Action("SearchAuthorsJson", "Authors", new { area = "Admin" }) ?? "",
                                SearchByIdUrl = Url.Action("SearchAuthorByIdJson", "Authors", new { area = "Admin" }) ?? "",
                                Multiple = true
                            })
                    </div>
                    <div>
                        @await Html.PartialAsync("_SelectInput", new SelectInputViewModel
                            {
                                EntityName = "publisher",
                                FieldName = "PublisherIds",
                                Header = "Publisher",
                                InputContainerPlaceholder = "Name",
                                SelectedIds = Model.Filter.PublisherIds,
                                SearchByQueryUrl = Url.Action("SearchPublishersJson", "Publishers", new { area = "Admin" }) ?? "",
                                SearchByIdUrl = Url.Action("SearchPublisherByIdJson", "Publishers", new { area = "Admin" }) ?? "",
                                Multiple = true
                            })
                    </div>
                    <div>
                        @await Html.PartialAsync("_SelectInput", new SelectInputViewModel
                            {
                                EntityName = "translator",
                                FieldName = "TranslatorIds",
                                Header = "Translators",
                                InputContainerPlaceholder = "Name",
                                SelectedIds = Model.Filter.TranslatorIds,
                                SearchByQueryUrl = Url.Action("SearchTranslatorsJson", "Translators", new { area = "Admin" }) ?? "",
                                SearchByIdUrl = Url.Action("SearchTranslatorByIdJson", "Translators", new { area = "Admin" }) ?? "",
                                Multiple = true
                            })
                    </div>
                    <div>
                        <label class="form-label">Year</label>
                        <div class="d-flex align-items-center">
                            <input name="YearFrom" type="number" min="0" class="form-control" placeholder="From"
                                   value="@Model.Filter.YearFrom">
                            <span class="px-1">–</span>
                            <input name="YearTo" type="number" min="0" class="form-control" placeholder="To"
                                   value="@Model.Filter.YearTo">
                        </div>
                    </div>
                    <div>
                        <label class="form-label">Pages</label>
                        <div class="d-flex align-items-center">
                            <input name="PagesFrom" type="number" min="0" class="form-control" placeholder="From"
                                   value="@Model.Filter.PagesFrom">
                            <span class="px-1">–</span>
                            <input name="PagesTo" type="number" min="0" class="form-control" placeholder="To"
                                   value="@Model.Filter.PagesTo">
                        </div>
                    </div>
                    <div>
                        <label class="form-label">Stock</label>
                        <div class="d-flex align-items-center">
                            <input name="StockFrom" type="number" min="0" class="form-control" placeholder="From"
                                   value="@Model.Filter.StockFrom">
                            <span class="px-1">–</span>
                            <input name="StockTo" type="number" min="0" class="form-control" placeholder="To"
                                   value="@Model.Filter.StockTo">
                        </div>
                    </div>
                    <div>
                        @await Html.PartialAsync("_SelectInput", new SelectInputViewModel
                            {
                                EntityName = "tag",
                                FieldName = "TagIds",
                                Header = "Tags",
                                InputContainerPlaceholder = "",
                                SelectedIds = Model.Filter.TagIds,
                                SearchByQueryUrl = Url.Action("SearchTagsJson", "Tags", new { area = "Admin" }) ?? "",
                                SearchByIdUrl = Url.Action("SearchTagByIdJson", "Tags", new { area = "Admin" }) ?? "",
                                Multiple = true
                            })
                    </div>
                    <div>
                        @await Html.PartialAsync("_SelectInput", new SelectInputViewModel
                            {
                                EntityName = "language",
                                FieldName = "LanguageIds",
                                Header = "Language",
                                InputContainerPlaceholder = "",
                                SelectedIds = Model.Filter.LanguageIds,
                                SearchByQueryUrl = Url.Action("SearchLanguagesJson", "Languages", new { area = "Admin" }) ?? "",
                                SearchByIdUrl = Url.Action("SearchLanguageByIdJson", "Languages", new { area = "Admin" }) ?? "",
                                Multiple = true
                            })
                    </div>
                    <div>
                        <label class="form-label d-block">Visibility</label>
                        <div class="d-flex flex-wrap row-gap-1">
                            <label class="form-check-label w-50">
                                <input type="checkbox" name="Visibility" value="visible" class="form-check-input"
                                       @(Model.Filter.Visibility.Contains("visible") ? "checked" : "")>
                                <span>Visible</span>
                            </label>
                            <label class="form-check-label w-50">
                                <input type="checkbox" name="Visibility" value="hidden" class="form-check-input"
                                       @(Model.Filter.Visibility.Contains("hidden") ? "checked" : "")>
                                <span>Hidden</span>
                            </label>
                        </div>
                    </div>
                    <div>
                        <label class="form-label d-block">Cover</label>
                        <div class="d-flex flex-wrap row-gap-1">
                            @foreach (var type in Enum.GetValues(typeof(CoverType)).Cast<CoverType>())
                            {
                                <label class="form-check-label w-50">
                                    <input type="checkbox" name="CoverTypes" value="@type" class="form-check-input"
                                           @(Model.Filter.CoverTypes.Contains(type) ? "checked" : "")>
                                    <span>@type</span>
                                </label>
                            }
                        </div>
                    </div>
                    <div>
                        <label class="form-label">Price</label>
                        <div class="d-flex align-items-center">
                            <input name="PriceFrom" type="number" min="1" class="form-control" placeholder="From"
                                   value="@Model.Filter.PriceFrom">
                            <span class="px-1">–</span>
                            <input name="PriceTo" type="number" min="1" class="form-control" placeholder="To"
                                   value="@Model.Filter.PriceTo">
                        </div>
                    </div>
                    <div>
                        <label class="form-label d-block">Discount</label>
                        <select name="DiscountId" class="form-select">
                            <option value="" selected="@(Model.Filter.DiscountId == null)">-</option>
                            <option value="-2" selected="@(Model.Filter.DiscountId == -2)">Any</option>
                            <option value="-1" selected="@(Model.Filter.DiscountId == -1)">None</option>
                            <optgroup label="Active">
                                @foreach (var discount in Model.Discounts)
                                {
                                    if (discount.IsActive())
                                    {
                                        <option value="@discount.Id" selected="@(discount.Id == Model.Filter.DiscountId)">
                                            @discount.Name (@discount.Display())
                                        </option>
                                    }
                                }
                            </optgroup>
                            <optgroup label="Scheduled">
                                @foreach (var discount in Model.Discounts)
                                {
                                    if (discount.IsScheduled())
                                    {
                                        <option value="@discount.Id" selected="@(discount.Id == Model.Filter.DiscountId)">
                                            @discount.Name (@discount.Display())
                                        </option>
                                    }
                                }
                            </optgroup>
                        </select>
                    </div>
                    <div>
                        <label class="form-label">Final price</label>
                        <div class="d-flex align-items-center">
                            <input name="FinalFrom" type="number" min="1" class="form-control" placeholder="From"
                                   value="@Model.Filter.FinalFrom">
                            <span class="px-1">–</span>
                            <input name="FinalTo" type="number" min="1" class="form-control" placeholder="To"
                                   value="@Model.Filter.FinalTo">
                        </div>
                    </div>
                </div>
                <div class="position-sticky d-flex gap-2 mt-auto border-top p-2">
                    <button type="submit" class="btn btn-primary w-100 d-flex align-items-center gap-2">
                        <i class="bi bi-search"></i>
                        Search
                    </button>
                    <a title="Clear filters" class="admin-filter-button btn btn-danger d-flex justify-content-center align-items-center" asp-action="Index">
                        <i class="bi bi-x-circle"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="~/js/admin/filter-scroll.js"></script>