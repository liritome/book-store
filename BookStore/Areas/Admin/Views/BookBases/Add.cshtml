@model BookBaseAddViewModel

@{
    ViewData["Title"] = "Add book base";
}

<form asp-action="Add" method="post" enctype="multipart/form-data">
    <div class="d-flex justify-content-between align-items-start">
        <h2>New Book Base</h2>
        <div class="d-flex gap-2">
            <button type="submit" class="admin-details-button btn btn-primary">
                <i class="bi bi-floppy"></i>
                <span>Create</span>
            </button>
            <button type="reset" class="admin-details-button btn btn-secondary">
                <i class="bi bi-arrow-clockwise"></i>
                <span>Clear</span>
            </button>
        </div>
    </div>

    <div class="mt-3">
        <div class="row">
            <div class="col-lg-5">
                <div class="bg-white rounded-4 p-3">
                    <div>
                        <div>
                            <h5>Details</h5>
                        </div>
                        <div class="list-group list-group-flush text-end">
                            <div class="list-group-item d-flex justify-content-between gap-2">
                                <span class="text-nowrap">Title</span>
                                <input name="Title" type="text" class="form-control admin-input-container py-0" />
                            </div>
                            <div class="list-group-item d-flex justify-content-between gap-2">
                                <span class="text-nowrap">Year</span>
                                <input name="Year" type="number" min="1" class="form-control admin-input-container py-0" />
                            </div>
                        </div>
                    </div>
                    <div class="mt-2">
                        <div>
                            <h5>Book Series</h5>
                        </div>
                        <div class="list-group list-group-flush">
                            <div class="list-group-item d-flex justify-content-between gap-2">
                                <span class="text-nowrap">Series</span>
                                <div>
                                    @await Html.PartialAsync("_SelectInput", new SelectInputViewModel<Series>
                                    {
                                        Label = "Series",
                                        Placeholder = "Name",
                                        Items = Model.Series,
                                        Name = "SeriesIds",
                                        GetIdFunc = a => a.Id,
                                        GetTextFunc = a => a.Name
                                    })
                                </div>
                            </div>
                            <div class="list-group-item d-flex justify-content-between gap-2">
                                <span class="text-nowrap">Number in series</span>
                                <input name="NumberInSeries" type="number" min="0" class="form-control admin-input-container py-0" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-7 mt-4 mt-lg-0">
                <div class="bg-white rounded-4 p-3">
                    <h5>Authors</h5>
                    @await Html.PartialAsync("_SelectInput", new SelectInputViewModel<Author>
                    {
                        Label = "Authors",
                        Placeholder = "Name",
                        Items = Model.Authors,
                        Name = "AuthorIds",
                        GetIdFunc = a => a.Id,
                        GetTextFunc = a => a.Name
                    })
                </div>
                <div class="bg-white rounded-4 p-3 mt-4">
                    <h5>Tags</h5>
                    @await Html.PartialAsync("_SelectInput", new SelectInputViewModel<Tag>
                    {
                        Label = "Tags",
                        Placeholder = "Name",
                        Items = Model.Tags,
                        Name = "TagIds",
                        GetIdFunc = a => a.Id,
                        GetTextFunc = a => a.Name
                    })
                </div>
            </div>
        </div>
    </div>
</form>