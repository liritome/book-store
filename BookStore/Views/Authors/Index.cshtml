@{
    ViewData["Title"] = "Authors";
}

@{
    var letters = new[] {
        'А', 'Б', 'В', 'Г', 'Ґ', 'Д', 'Е', 'Є', 'Ж', 'З', 'И', 'І', 'Ї', 'Й',
        'К', 'Л', 'М', 'Н', 'О', 'П', 'Р', 'С', 'Т', 'У', 'Ф', 'Х', 'Ц', 'Ч',
        'Ш', 'Щ', 'Ь', 'Ю', 'Я'
    };
}

<div class="p-3 bg-white rounded-4 mt-4">
    <div class="d-flex flex-wrap gap-2">
        @foreach (var letter in letters)
        {
            <div class="text-center">
                <a asp-controller="Authors" asp-action="Index" asp-route-letter="@letter" class="authors-letter-button btn btn-outline-dark rounded-5 d-flex justify-content-center align-items-center">
                    @letter
                </a>
            </div>
        }
    </div>
</div>
<div class="flex-fill mt-3">
    <input type="search" class="form-control rounded-5" placeholder="Search author" />
</div>
<div class="mt-3 p-3 bg-white">
    <ul class="authors-list d-grid column-gap-4 row-gap-1 list-unstyled">
        @for (int i = 0; i < 35; i++)
        {
            <li class="authors-list-item d-flex gap-1 align-items-center rounded-3 w-100 px-2 py-1">
                <a asp-controller="Authors" asp-action="Details" asp-route-slug="author-name" class="flex-grow-1">
                    Author Name
                </a>
                <span class="authors-list-item-books text-muted">(@i)</span>
            </li>
        }
    </ul>
</div>