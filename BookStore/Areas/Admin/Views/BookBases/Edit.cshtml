@model BookBaseEditViewModel

@{
    ViewData["Title"] = "Edit book base";
}

<form asp-action="Edit" asp-route-id="@Model.BookBase.Id" method="post" enctype="multipart/form-data">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h2 class="mb-1">@Model.BookBase.Title</h2>
            <div class="d-flex gap-2 align-items-center">
                <span class="text-muted">ID: @Model.BookBase.Id</span>
                <input hidden name="BookBaseId" type="number" value="@Model.BookBase.Id" />
            </div>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="admin-details-button btn btn-primary">
                <i class="bi bi-floppy"></i>
                <span>Save</span>
            </button>
            <button type="reset" class="admin-details-button btn btn-secondary">
                <i class="bi bi-arrow-clockwise"></i>
                <span>Reset</span>
            </button>
        </div>
    </div>

    <div class="mt-3">
        <div class="row">
            <div class="col-lg-5">
                <div class="bg-white rounded-4 p-3">
                    <div>
                        <div>
                            <h5>Details</h5>
                        </div>
                        <div class="list-group list-group-flush text-end">
                            <div class="list-group-item d-flex justify-content-between gap-2">
                                <span class="text-nowrap">Title</span>
                                <input name="Title" type="text" class="form-control admin-input-container py-0"
                                       value="@Model.BookBase.Title" />
                            </div>
                            <div class="list-group-item d-flex justify-content-between gap-2">
                                <span class="text-nowrap">Year</span>
                                <input name="Year" type="number" min="1" class="form-control admin-input-container py-0"
                                       value="@Model.BookBase.Year" />
                            </div>
                        </div>
                    </div>
                    <div class="mt-2">
                        <div>
                            <h5>Book Series</h5>
                        </div>
                        <div class="list-group list-group-flush">
                            <div class="list-group-item d-flex justify-content-between gap-2">
                                <span class="text-nowrap">Series</span>
                                <div>
                                    @await Html.PartialAsync("_SelectInput", new SelectInputViewModel
                                    {
                                        EntityName = "series",
                                        FieldName = "SeriesId",
                                        SelectedIds = Model.BookBase.SeriesId == null ? new List<int>()
                                            : new List<int> { Model.BookBase.SeriesId.Value },
                                        InputContainerPlaceholder = "Series name",
                                        SearchByQueryUrl = Url.Action("SearchSeriesJson", "Series", new { area = "Admin" }) ?? "",
                                        SearchByIdUrl = Url.Action("SearchSeriesByIdJson", "Series", new { area = "Admin" }) ?? ""
                                    })
                                </div>
                            </div>
                            <div class="list-group-item d-flex justify-content-between gap-2">
                                <span class="text-nowrap">Number in series</span>
                                <input name="NumberInSeries" type="number" min="0" class="form-control admin-input-container py-0"
                                       value="@Model.BookBase.NumberInSeries" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-7 mt-4 mt-lg-0">
                <div class="bg-white rounded-4 p-3">
                    <h5>Authors</h5>
                    @await Html.PartialAsync("_SelectInput", new SelectInputViewModel
                    {
                        EntityName = "author",
                        FieldName = "AuthorIds",
                        SelectedIds = Model.BookBase.Authors.Select(a => a.Id).ToList(),
                        InputContainerPlaceholder = "Author name",
                        SearchByQueryUrl = Url.Action("SearchAuthorsJson", "Authors", new { area = "Admin" }) ?? "",
                        SearchByIdUrl = Url.Action("SearchAuthorByIdJson", "Authors", new { area = "Admin" }) ?? "",
                        Multiple = true
                    })
                </div>
                <div class="bg-white rounded-4 p-3 mt-4">
                    <h5>Tags</h5>
                    @await Html.PartialAsync("_SelectInput", new SelectInputViewModel
                    {
                        EntityName = "tag",
                        FieldName = "TagIds",
                        SelectedIds = Model.BookBase.Tags.Select(t => t.Id).ToList(),
                        InputContainerPlaceholder = "Tag name",
                        SearchByQueryUrl = Url.Action("SearchTagsJson", "Tags", new { area = "Admin" }) ?? "",
                        SearchByIdUrl = Url.Action("SearchTagByIdJson", "Tags", new { area = "Admin" }) ?? "",
                        Multiple = true
                    })
                </div>
            </div>
        </div>
    </div>
</form>