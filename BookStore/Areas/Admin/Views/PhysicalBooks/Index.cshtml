@model PhysicalBookIndexViewModel

@{
    ViewData["Title"] = "Books";
    var currentSort = Model.Input.Sort;
}

<div class="d-flex">
    <div class="admin-table-left">

        <!-- Add button -->
        <div class="d-flex gap-2">
            <a class="btn btn-primary d-flex align-items-center gap-2" asp-action="Add">
                <i class="bi bi-plus-circle"></i>
                <span>Add Book</span>
            </a>
        </div>

        <!-- Pagination top -->
        <div class="mt-2 d-flex justify-content-start">
            <div>
                <div class="mb-2">
                    Showing 1-10 of 100 books
                </div>
                <nav>
                    <ul class="pagination">
                        <li class="page-item">
                            <a class="page-link">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>
                        <li class="page-item">
                            <a class="page-link">
                                1
                            </a>
                        </li>
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                        @for (int i = 5 - 1; i < 5 + 2; i++) // page = 5
                        {
                            <li class="page-item @(i == 5 ? "active" : "")">
                                <a class="page-link">
                                    @i
                                </a>
                            </li>
                        }
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                        <li class="page-item">
                            <a class="page-link">
                                40
                            </a>
                        </li>
                        <li class="page-item">
                            <a class="page-link">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>

        <!-- Table -->
        <div class="bg-white rounded-4 overflow-auto">
            <table class="table admin-table align-middle mt-3">
                <thead>
                    <tr>
                        <th></th>
                        <th>
                            <a asp-action="Index" asp-route-sort="@Model.IdSort">
                                ID
                                <i class="bi @(currentSort == PhysicalBookSortState.IdAsc ? "bi-caret-down-fill"
                                                                       : currentSort == PhysicalBookSortState.IdDesc ? "bi-caret-up-fill" : "")"></i>
                            </a>
                        </th>
                        <th>Image</th>
                        <th>
                            <a asp-action="Index" asp-route-sort="@Model.TitleSort">
                                Title
                                <i class="bi @(currentSort == PhysicalBookSortState.TitleAsc ? "bi-caret-down-fill"
                                                                       : currentSort == PhysicalBookSortState.TitleDesc ? "bi-caret-up-fill" : "")"></i>
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index" asp-route-sort="@Model.CoverSort">
                                Cover
                                <i class="bi @(currentSort == PhysicalBookSortState.CoverAsc ? "bi-caret-down-fill"
                                                                       : currentSort == PhysicalBookSortState.CoverDesc ? "bi-caret-up-fill" : "")"></i>
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index" asp-route-sort="@Model.IsbnSort">
                                ISBN
                                <i class="bi @(currentSort == PhysicalBookSortState.IsbnAsc ? "bi-caret-down-fill"
                                                                       : currentSort == PhysicalBookSortState.IsbnDesc ? "bi-caret-up-fill" : "")"></i>
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index" asp-route-sort="@Model.PriceSort">
                                Price
                                <i class="bi @(currentSort == PhysicalBookSortState.PriceAsc ? "bi-caret-down-fill"
                                                                       : currentSort == PhysicalBookSortState.PriceDesc ? "bi-caret-up-fill" : "")"></i>
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index" asp-route-sort="@Model.DiscountSort">
                                Discount
                                <i class="bi @(currentSort == PhysicalBookSortState.DiscountAsc ? "bi-caret-down-fill"
                                                                       : currentSort == PhysicalBookSortState.DiscountDesc ? "bi-caret-up-fill" : "")"></i>
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index" asp-route-sort="@Model.FinalPriceSort">
                                Final
                                <i class="bi @(currentSort == PhysicalBookSortState.FinalPriceAsc ? "bi-caret-down-fill"
                                                                       : currentSort == PhysicalBookSortState.FinalPriceDesc ? "bi-caret-up-fill" : "")"></i>
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index" asp-route-sort="@Model.StockSort">
                                Stock
                                <i class="bi @(currentSort == PhysicalBookSortState.StockAsc ? "bi-caret-down-fill"
                                                                       : currentSort == PhysicalBookSortState.StockDesc ? "bi-caret-up-fill" : "")"></i>
                            </a>
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var book in Model.Books)
                    {
                        <tr>
                            <td class="admin-table-status">
                                @if (book.IsVisible)
                                {
                                    <div class="bg-success-subtle"></div>
                                }
                                else
                                {
                                    <div class="bg-secondary-subtle"></div>
                                }
                            </td>
                            <td>
                                <a class="text-primary" asp-area="Admin" asp-controller="PhysicalBooks" asp-action="Details" asp-route-id="@book.Id">
                                    @book.Id
                                </a>
                            </td>
                            <td>
                                @if (book.Images.Count > 0)
                                {
                                    <img src="~/images/productImages/@book.OrderedImages.FirstOrDefault()?.Url" class="admin-image" />
                                }
                                else
                                {
                                    <img src="~/images/book-empty-small.png" class="admin-image" />
                                }
                            </td>
                            <td>
                                <span class="admin-book-table-title" title="@book.Name">
                                    @book.Name
                                </span>
                            </td>
                            <td>
                                <span class="admin-book-table-type">
                                    @(book.CoverType == CoverType.Hardcover ? "Hardcover" : "Paperback")
                                </span>
                            </td>
                            <td>
                                <span class="admin-book-table-isbn">@book.Isbn</span>
                            </td>
                            <td>@book.Price ₴</td>
                            <td class="text-center">
                                @if (book.DiscountId == null)
                                {
                                    <i class="admin-book-discount-icon bi bi-x text-danger"></i>
                                }
                                else
                                {
                                    <i class="admin-book-discount-icon bi bi-check text-success"></i>
                                }
                            </td>
                            <td>@book.FinalPrice ₴</td>
                            <td>@book.Stock</td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a class="admin-table-btn btn btn-primary" asp-area="Admin" asp-controller="PhysicalBooks" asp-action="Edit" asp-route-id="@book.Id">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="ToggleVisibility" asp-route-id="@book.Id" method="post">
                                        @if (book.IsVisible)
                                        {
                                            <button type="submit" class="admin-table-btn btn btn-secondary">
                                                <i class="bi bi-eye-slash"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="admin-table-btn btn btn-success">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        }
                                    </form>
                                    <form asp-action="Delete" asp-route-id="@book.Id" method="post" onsubmit="return confirm('Delete @book.Name (ID: @book.Id)?')">
                                        <button type="submit" class="admin-table-btn btn btn-danger">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Filters -->
    <div class="admin-table-right ms-4 position-relative">
        <div class="admin-table-filter bg-white rounded-4 sticky-top">
            <form asp-action="Index" method="get">
                <div class="admin-table-filter-scrollable d-flex flex-column overflow-y-auto">
                    <div>
                        <label class="form-label">Book</label>
                        <input name="Query" type="text" class="form-control" placeholder="Title, ID or ISBN"
                               value="@Model.Input.Query">
                    </div>
                    <div>
                        <label class="form-label">Author</label>
                        <select name="AuthorId" class="form-select">
                            <option value="" selected="@(Model.Input.AuthorId == null ? "selected" : "")">-</option>
                            @foreach (var author in Model.Authors)
                            {
                                <option value="@author.Id" selected="@(author.Id == Model.Input.AuthorId)">
                                    @author.Name
                                </option>
                            }
                        </select>
                        @* <input class="form-control" type="text" id="authorInput" palceholder="Name" autocomplete="off"/>
                        <input type="hidden" id="authorId" name="AuthorId"/>
                        <div></div> *@
                    </div>
                    <div>
                        <label class="form-label">Publisher</label>
                        <select name="PublisherId" class="form-select">
                            <option value="" selected="@(Model.Input.PublisherId == null)">-</option>
                            @foreach (var publisher in Model.Publishers)
                            {
                                <option value="@publisher.Id" selected="@(publisher.Id == Model.Input.PublisherId)">
                                    @publisher.Name
                                </option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label">Translator</label>
                        <select name="TranslatorId" class="form-select">
                            <option value="" selected="@(Model.Input.TranslatorId == null)">-</option>
                            @foreach (var translator in Model.Translators)
                            {
                                <option value="@translator.Id" selected="@(translator.Id == Model.Input.TranslatorId)">
                                    @translator.Name
                                </option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label">Year</label>
                        <div class="d-flex align-items-center">
                            <input name="YearFrom" type="number" min="0" class="form-control" placeholder="From"
                                   value="@Model.Input.YearFrom">
                            <span class="px-1">–</span>
                            <input name="YearTo" type="number" min="0" class="form-control" placeholder="To"
                                   value="@Model.Input.YearTo">
                        </div>
                    </div>
                    <div>
                        <label class="form-label">Pages</label>
                        <div class="d-flex align-items-center">
                            <input name="PagesFrom" type="number" min="0" class="form-control" placeholder="From"
                                   value="@Model.Input.PagesFrom">
                            <span class="px-1">–</span>
                            <input name="PagesTo" type="number" min="0" class="form-control" placeholder="To"
                                   value="@Model.Input.PagesTo">
                        </div>
                    </div>
                    <div>
                        <label class="form-label">Stock</label>
                        <div class="d-flex align-items-center">
                            <input name="StockFrom" type="number" min="0" class="form-control" placeholder="From"
                                   value="@Model.Input.StockFrom">
                            <span class="px-1">–</span>
                            <input name="StockTo" type="number" min="0" class="form-control" placeholder="To"
                                   value="@Model.Input.StockTo">
                        </div>
                    </div>
                    <div>
                        <label class="form-label">Language</label>
                        <select name="LanguageId" class="form-select">
                            <option value="" selected="@(Model.Input.LanguageId == null)">-</option>
                            @foreach (var language in Model.Languages)
                            {
                                <option value="@language.Id" selected="@(language.Id == Model.Input.LanguageId)">
                                    @language.Name
                                </option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label d-block">Visibility</label>
                        <div class="d-flex flex-wrap row-gap-1">
                            <label class="form-check-label w-50">
                                <input class="form-check-input" type="checkbox" name="Visibility" value="visible"
                                       @(Model.Input.Visibility.Contains("visible") ? "checked" : "")>
                                <span>Visible</span>
                            </label>
                            <label class="form-check-label w-50">
                                <input class="form-check-input" type="checkbox" name="Visibility" value="hidden"
                                       @(Model.Input.Visibility.Contains("hidden") ? "checked" : "")>
                                <span>Hidden</span>
                            </label>
                        </div>
                    </div>
                    <div>
                        <label class="form-label d-block">Cover</label>
                        <div class="d-flex flex-wrap row-gap-1">
                            @foreach(var type in Enum.GetValues(typeof(CoverType)).Cast<CoverType>())
                            {
                                <label class="form-check-label w-50">
                                    <input class="form-check-input" type="checkbox" name="CoverTypes" value="@type"
                                           @(Model.Input.CoverTypes.Contains(type) ? "checked" : "")>
                                    <span>@type</span>
                                </label>
                            }
                        </div>
                    </div>
                    <div>
                        <label class="form-label">Price</label>
                        <div class="d-flex align-items-center">
                            <input name="PriceFrom" type="number" min="1" class="form-control" placeholder="From"
                                   value="@Model.Input.PriceFrom">
                            <span class="px-1">–</span>
                            <input name="PriceTo" type="number" min="1" class="form-control" placeholder="To"
                                   value="@Model.Input.PriceTo">
                        </div>
                    </div>
                    <div>
                        <label class="form-label d-block">Discount</label>
                        <select name="DiscountId" class="form-select">
                            <option value="" selected="@(Model.Input.DiscountId == null)">-</option>
                            <option value="-2" selected="@(Model.Input.DiscountId == -2)">Any</option>
                            <option value="-1" selected="@(Model.Input.DiscountId == -1)">None</option>
                            <optgroup label="Discounts">
                                @foreach (var discount in Model.Discounts)
                                {
                                    <option value="@discount.Id" selected="@(discount.Id == Model.Input.DiscountId)">
                                        @discount.Name
                                    </option>
                                }
                            </optgroup>
                        </select>
                    </div>
                    <div>
                        <label class="form-label">Final price</label>
                        <div class="d-flex align-items-center">
                            <input name="FinalFrom" type="number" min="1" class="form-control" placeholder="From"
                                   value="@Model.Input.FinalFrom">
                            <span class="px-1">–</span>
                            <input name="FinalTo" type="number" min="1" class="form-control" placeholder="To"
                                   value="@Model.Input.FinalTo">
                        </div>
                    </div>
                </div>
                <div class="position-sticky d-flex gap-2 mt-auto border-top p-2">
                    <button type="submit" class="btn btn-primary w-100 d-flex align-items-center gap-2">
                        <i class="bi bi-search"></i>
                        Search
                    </button>
                    <button type="reset" class="admin-filter-button btn btn-secondary d-flex justify-content-center align-items-center" title="Reset form">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </button>
                    <a class="admin-filter-button btn btn-danger d-flex justify-content-center align-items-center" asp-action="Index" title="Clear filters">
                        <i class="bi bi-x-circle"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const rightPanel = document.querySelector('.admin-table-right');
        const rightScroll = document.querySelector('.admin-table-filter-scrollable');

        rightPanel.addEventListener('wheel', function (e) {
            const atTop = rightScroll.scrollTop === 0;
            const atBottom = rightScroll.scrollTop + rightScroll.clientHeight >= rightScroll.scrollHeight - 1;
            if (atTop && e.deltaY < 0) e.preventDefault();
            if (atBottom && e.deltaY > 0) e.preventDefault();
        }, { passive: false });
    });
</script>