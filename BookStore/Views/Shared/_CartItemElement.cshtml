<div class="d-flex flex-column rounded-4 border border-1 mt-3 p-2">
    <div class="d-flex border-bottom p-2">
        <a class="cart-image flex-shrink-0" asp-controller="Catalog" asp-action="Details" asp-route-slug="book-title">
            <img src="~/images/book-empty.png" />
        </a>
        <div class="d-flex flex-column gap-1 ps-3">
            <a class="orders-details-title" asp-controller="Catalog" asp-action="Details" asp-route-slug="book-title">
                <span>Book title super long version. Book 9. Delux edition</span>
            </a>
            <span class="orders-details-author text-muted">Author Name</span>
        </div>
        <div class="ms-auto">
            <button class="cart-remove-button btn btn-light rounded-4 d-flex justify-content-center align-items-center">
                <i class="bi bi-trash3"></i>
            </button>
        </div>
    </div>
    <div class="d-flex justify-content-between align-items-center pt-2 px-2">
        <div class="d-flex">
            <button disabled class="cart-count-button btn btn-light d-flex justify-content-center align-items-center">
                <i class="bi bi-dash"></i>
            </button>
            <div class="cart-count d-flex justify-content-center align-items-center">
                1
            </div>
            <button class="cart-count-button btn btn-light d-flex justify-content-center align-items-center">
                <i class="bi bi-plus"></i>
            </button>
        </div>
        <div>
            <span class="cart-price">400 UAH</span>
        </div>
    </div>
</div>