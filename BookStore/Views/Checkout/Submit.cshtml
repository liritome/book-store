@{
    ViewData["Title"] = "Checkout";
}

<div class="position-fixed top-0 start-0 d-flex justify-content-center align-items-center h-100 w-100">
    <div class="checkout-submit-shadow bg-white rounded-5 py-4 px-5 d-flex flex-column align-items-center">
        <h2>Thank you!</h2>
        <div class="checkout-submit-success text-success d-flex align-items-center">
            <i class="bi bi-check"></i>
            <span>Your order has been successfully placed</span>
        </div>
        <div class="d-flex gap-4 w-100 mt-3">
            <a class="w-100 btn btn-success rounded-4 d-flex justify-content-center align-items-center py-2 px-3" asp-controller="Catalog" asp-action="Index">
                To catalog
            </a>
            <a class="w-100 btn btn-success rounded-4 d-flex justify-content-center align-items-center py-2 px-3" asp-controller="Orders" asp-action="Index">
                To my orders
            </a>
        </div>
    </div>
</div>